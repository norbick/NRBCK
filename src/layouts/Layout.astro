---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'NRBCK',
	description = 'NRBCK website.',
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}nrbck-favicon.svg?v=4`} />
		<link rel="shortcut icon" type="image/svg+xml" href={`${baseUrl}nrbck-favicon.svg?v=4`} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#08090d" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
