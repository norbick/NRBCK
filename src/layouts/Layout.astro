---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'NRBCK | Portfolio',
	description = 'Portfolio projektow: m2_stage i LooLoot.',
} = Astro.props;
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${Astro.base}favicon.svg`} />
		<link rel="icon" href={`${Astro.base}favicon.ico`} />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
