---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		id: '01',
		name: 'm2_stage',
		role: 'Event platform MVP',
		blurb:
			'Koncept platformy eventowej: szybkie flow publikacji, czytelny funnel i testy UX na wczesnym etapie.',
		tags: ['UX Flow', 'MVP', 'Frontend Direction'],
		repo: 'https://github.com/norbick/m2_stage',
		theme: 'theme-pink',
	},
	{
		id: '02',
		name: 'LooLoot',
		role: 'Collectible drop concept',
		blurb:
			'Projekt around drop mechanics i kolekcjonowanie przedmiotow, ze stylem opartym o rytm i mocny feedback.',
		tags: ['Drop Logic', 'Game Economy', 'Product Visuals'],
		repo: 'https://github.com/norbick/LooLoot',
		theme: 'theme-cyan',
	},
];

const labFrames = [
	{ title: 'Visual Systems', text: 'Brand energy, typography tension, contrast control.', tone: 'tone-lime' },
	{ title: 'Interaction Rhythm', text: 'Motion timing, scroll behavior, kinetic composition.', tone: 'tone-amber' },
	{ title: 'Fast Iteration', text: 'From sketch to deploy in very short loops.', tone: 'tone-cyan' },
	{ title: 'Signal Layering', text: 'Depth from overlays, scanlines and moving rails.', tone: 'tone-pink' },
];

const signals = [
	'GLITCH MODE',
	'KINETIC UI',
	'NRBCK',
	'ASTRO BUILD',
	'SIGNAL ACTIVE',
	'NO SAFE LAYOUT',
	'MOTION RHYTHM',
	'CREATIVE ENGINEERING',
	'WEB DESIGN LAB',
	'INTERACTION DIRECTION',
	'BRAND ENERGY',
	'UI + CODE',
	'FAST ITERATION',
	'VISUAL TENSION',
	'DEPLOY LOOP',
	'PORTFOLIO FEED',
];

const signalTrack = [...signals, ...signals];

const bendPresets = [
	{ rot: -18, skew: -6.2, hoverRot: -25, hoverSkew: -7.8, ty: -18, tyHover: -26 },
	{ rot: 16, skew: 5.4, hoverRot: 24, hoverSkew: 7.2, ty: 14, tyHover: 24 },
	{ rot: -14, skew: 6.8, hoverRot: -22, hoverSkew: 8.4, ty: 20, tyHover: 28 },
	{ rot: 20, skew: -5.6, hoverRot: 28, hoverSkew: -7.5, ty: -12, tyHover: -22 },
	{ rot: -22, skew: 4.5, hoverRot: -30, hoverSkew: 6.2, ty: 10, tyHover: 18 },
	{ rot: 13, skew: -7.1, hoverRot: 21, hoverSkew: -9.2, ty: -16, tyHover: -24 },
	{ rot: -16, skew: -4.8, hoverRot: -24, hoverSkew: -6.8, ty: 12, tyHover: 20 },
	{ rot: 19, skew: 6.1, hoverRot: 27, hoverSkew: 8.6, ty: -8, tyHover: -18 },
	{ rot: -12, skew: 7.2, hoverRot: -20, hoverSkew: 9.1, ty: 16, tyHover: 26 },
	{ rot: 15, skew: -6.3, hoverRot: 23, hoverSkew: -8.1, ty: -20, tyHover: -28 },
];

const hash = (value: string) => [...value].reduce((acc, char, index) => acc + char.charCodeAt(0) * (index + 1), 0);

const withTwist = <T extends { name?: string; title?: string }>(items: T[]) =>
	items.map((item, index) => {
		const key = item.name ?? item.title ?? String(index);
		const preset = bendPresets[(hash(key) + index * 7) % bendPresets.length];
		return { ...item, twist: preset };
	});

const projectPanels = withTwist(projects);
const framePanels = withTwist(labFrames);
---

<Layout title="NRBCK | Kinetic Glitch" description="Portfolio NRBCK w wersji glitch/kinetycznej.">
	<main class="shell">
		<div class="scanlines" aria-hidden="true"></div>
		<div class="vignette" aria-hidden="true"></div>

		<div class="scroll-hint" id="scroll-hint">
			<span class="wheel" aria-hidden="true"></span>
			<span class="hint-text">Desktop: scroll down moves right</span>
			<span class="arrow" aria-hidden="true">→</span>
		</div>

		<section class="rail" id="horizontal-rail">
			<article class="panel panel-hero reveal reveal-1">
				<nav class="topbar">
					<p class="brand">NRBCK</p>
					<div class="controls">
						<a href="mailto:norbick@gmail.com">Contact</a>
						<span aria-hidden="true"></span>
						<span aria-hidden="true"></span>
					</div>
				</nav>

				<h1 class="headline">
					<span class="glitch-line line-top" data-text="FREELANCE WEB DESIGNER">FREELANCE WEB DESIGNER</span>
					<span class="glitch-line line-bottom" data-text="&amp; WEBFLOW DEVELOPER">&amp; WEBFLOW DEVELOPER</span>
				</h1>

				<div class="hero-bottom">
					<p>
						I shape web experiences that feel alive: strong typography, deliberate friction and clean
						interaction logic.
					</p>
					<div>
						<p>
							Current focus: personal portfolio, m2_stage and LooLoot. This version is intentionally kinetic
							and driven by motion.
						</p>
						<a class="hero-link" href="#projects">Open project lanes</a>
					</div>
				</div>
			</article>

			{projectPanels.map((project) => (
				<article id={project.id === '01' ? 'projects' : undefined} class={`panel panel-project ${project.theme}`}>
					<div
						class="project-frame"
						style={`--rot:${project.twist.rot}deg; --sk:${project.twist.skew}deg; --rot-hover:${project.twist.hoverRot}deg; --sk-hover:${project.twist.hoverSkew}deg; --ty:${project.twist.ty}px; --ty-hover:${project.twist.tyHover}px;`}
					>
						<p class="project-id">{project.id}</p>
						<p class="project-role">{project.role}</p>
						<h2>{project.name}</h2>
						<p class="project-copy">{project.blurb}</p>
						<ul aria-label={`Highlights for ${project.name}`}>
							{project.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
						<a href={project.repo} target="_blank" rel="noreferrer">Open Repo</a>
					</div>
				</article>
			))}

			<article class="panel panel-lab reveal reveal-3">
				<div class="lab-grid">
					{framePanels.map((frame) => (
						<article
							class={`lab-card ${frame.tone}`}
							style={`--rot:${frame.twist.rot}deg; --sk:${frame.twist.skew}deg; --rot-hover:${frame.twist.hoverRot}deg; --sk-hover:${frame.twist.hoverSkew}deg; --ty:${frame.twist.ty}px; --ty-hover:${frame.twist.tyHover}px;`}
						>
							<h3>{frame.title}</h3>
							<p>{frame.text}</p>
						</article>
					))}
				</div>
			</article>
		</section>

		<aside class="global-signal" aria-label="Signal rail">
			<div class="global-signal-track" aria-hidden="true">
				{signalTrack.map((item) => (
					<span>{item}</span>
				))}
			</div>
		</aside>
	</main>

	<script is:inline>
		const rail = document.getElementById('horizontal-rail');
		const hint = document.getElementById('scroll-hint');
		const desktop = window.matchMedia('(min-width: 921px)');

		if (rail) {
			const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
			let target = rail.scrollLeft;
			let current = rail.scrollLeft;
			let raf = 0;

			const updateHint = () => {
				if (!hint) return;
				if (!desktop.matches || rail.scrollLeft > 60) hint.classList.add('is-hidden');
				else hint.classList.remove('is-hidden');
			};

			const animate = () => {
				const diff = target - current;
				current += diff * 0.14;
				rail.scrollLeft = current;
				updateHint();
				if (Math.abs(diff) > 0.35) raf = requestAnimationFrame(animate);
				else {
					current = target;
					rail.scrollLeft = current;
					raf = 0;
				}
			};

			const moveBy = (delta) => {
				target = clamp(target + delta, 0, rail.scrollWidth - rail.clientWidth);
				if (!raf) raf = requestAnimationFrame(animate);
			};

			const onWheel = (event) => {
				if (!desktop.matches) return;
				const source = Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX;
				if (source === 0) return;
				event.preventDefault();
				const normalized = Math.sign(source) * Math.min(Math.abs(source), 96);
				moveBy(normalized * 2.8);
			};

			const onKey = (event) => {
				if (!desktop.matches) return;
				if (event.key === 'ArrowDown' || event.key === 'PageDown') {
					event.preventDefault();
					moveBy(window.innerWidth * 0.84);
				}
				if (event.key === 'ArrowUp' || event.key === 'PageUp') {
					event.preventDefault();
					moveBy(-window.innerWidth * 0.84);
				}
			};

			const onDesktopChange = () => {
				if (!desktop.matches) {
					if (raf) {
						cancelAnimationFrame(raf);
						raf = 0;
					}
					rail.scrollLeft = 0;
					target = 0;
					current = 0;
				}
				updateHint();
			};

			window.addEventListener('wheel', onWheel, { passive: false });
			window.addEventListener('keydown', onKey);
			rail.addEventListener('scroll', updateHint, { passive: true });
			desktop.addEventListener('change', onDesktopChange);
			updateHint();
		}
	</script>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@500;600&family=Sora:wght@400;600;700&display=swap');

	:root {
		--bg-0: #02050b;
		--bg-1: #050d1b;
		--bg-2: #0d1f3f;
		--ink: #e8f1ff;
		--ink-soft: #99adcb;
		--line: rgb(152 188 238 / 0.3);
		--cyan: #1be6ff;
		--pink: #ff2fa7;
		--acid: #ccff37;
		--amber: #ff9f2f;
	}

	:global(body) {
		font-family: 'Sora', 'Trebuchet MS', sans-serif;
		color: var(--ink);
		background:
			radial-gradient(46rem 32rem at 8% 8%, rgb(255 47 167 / 0.2), transparent 70%),
			radial-gradient(40rem 30rem at 92% 14%, rgb(27 230 255 / 0.2), transparent 72%),
			linear-gradient(130deg, var(--bg-0) 0%, var(--bg-1) 45%, var(--bg-2) 100%);
	}

	@media (min-width: 921px) {
		:global(body) {
			overflow: hidden;
		}
	}

	.shell {
		position: relative;
		min-height: 100vh;
	}

	.scanlines {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 2;
		background: repeating-linear-gradient(
			to bottom,
			rgb(255 255 255 / 0.02) 0,
			rgb(255 255 255 / 0.02) 1px,
			rgb(0 0 0 / 0) 2px,
			rgb(0 0 0 / 0) 4px
		);
		animation: scan-shift 12s linear infinite;
	}

	.vignette {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 1;
		box-shadow: inset 0 0 200px rgb(0 0 0 / 0.66);
	}

	.scroll-hint {
		position: fixed;
		right: 1rem;
		bottom: 3.5rem;
		z-index: 9;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.55rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgb(2 8 18 / 0.76);
		backdrop-filter: blur(4px);
		transition: opacity 260ms ease, transform 260ms ease;
	}

	.scroll-hint.is-hidden {
		opacity: 0;
		transform: translateY(14px);
		pointer-events: none;
	}

	.wheel {
		display: inline-block;
		width: 0.85rem;
		height: 1.25rem;
		border-radius: 999px;
		border: 1px solid var(--ink-soft);
		position: relative;
	}

	.wheel::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0.2rem;
		width: 0.18rem;
		height: 0.22rem;
		margin-left: -0.09rem;
		border-radius: 999px;
		background: var(--ink-soft);
		animation: wheel-dot 2s ease infinite;
	}

	.hint-text {
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.arrow {
		font-size: 0.95rem;
		animation: arrow-nudge 2s ease infinite;
	}

	.rail {
		position: relative;
		z-index: 4;
		display: flex;
		height: 100vh;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: none;
		gap: 1.2rem;
		padding: 1rem 1rem 4.2rem;
		scrollbar-width: none;
	}

	.rail::-webkit-scrollbar {
		display: none;
	}

	.panel {
		flex: 0 0 calc(100vw - 2rem);
		height: calc(100vh - 5.2rem);
		padding: clamp(0.9rem, 2vw, 1.6rem);
		overflow: visible;
	}

	.panel-hero {
		display: grid;
		grid-template-rows: auto 1fr auto;
	}

	.topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.8rem;
	}

	.brand {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.controls {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.controls a {
		text-decoration: none;
		color: var(--ink);
		font-size: 0.72rem;
		padding: 0.38rem 0.68rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: rgb(255 255 255 / 0.04);
	}

	.controls span {
		display: inline-block;
		width: 1.6rem;
		height: 1.6rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgb(255 255 255 / 0.05);
	}

	.headline {
		margin: 0.6rem 0 0;
		font-family: 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(2.3rem, 9vw, 6.1rem);
		line-height: 0.88;
		letter-spacing: 0.02em;
		display: grid;
		gap: 0.08em;
	}

	.glitch-line {
		position: relative;
		display: block;
		width: fit-content;
		text-transform: uppercase;
	}

	.glitch-line::before,
	.glitch-line::after {
		content: attr(data-text);
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0.72;
		will-change: transform;
	}

	.line-top {
		color: var(--amber);
	}

	.line-bottom {
		color: var(--cyan);
	}

	.line-top::before {
		color: var(--pink);
		animation: glitch-smooth-a 14s linear infinite;
	}

	.line-top::after {
		color: var(--acid);
		animation: glitch-smooth-b 16s linear infinite;
	}

	.line-bottom::before {
		color: var(--amber);
		animation: glitch-smooth-c 15s linear infinite;
	}

	.line-bottom::after {
		color: var(--pink);
		animation: glitch-smooth-d 13.5s linear infinite;
	}

	.hero-bottom {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		align-items: end;
	}

	.hero-bottom p {
		margin: 0;
		font-size: 0.96rem;
		line-height: 1.56;
		color: var(--ink-soft);
	}

	.hero-link {
		margin-top: 0.85rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.52rem 0.84rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		text-decoration: none;
		font-weight: 700;
		color: var(--ink);
		background: linear-gradient(125deg, var(--pink), var(--amber));
	}

	.panel-project {
		display: grid;
		place-items: center;
	}

	.project-frame,
	.lab-card {
		transform: translateY(var(--ty)) rotate(var(--rot)) skewX(var(--sk));
		transform-origin: center;
		transition: transform 300ms ease, box-shadow 220ms ease, border-color 220ms ease;
	}

	.project-frame:hover,
	.lab-card:hover {
		transform: translateY(var(--ty-hover)) rotate(var(--rot-hover)) skewX(var(--sk-hover));
	}

	.project-frame {
		width: min(900px, 88%);
		padding: 1.1rem;
		border-radius: 22px;
		border: 2px solid var(--line);
		background: rgb(4 14 31 / 0.86);
		box-shadow: 0 24px 36px rgb(0 0 0 / 0.48);
		display: grid;
		gap: 0.72rem;
	}

	.project-id {
		margin: 0;
		font-family: 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(1.8rem, 4vw, 2.9rem);
		line-height: 1;
		color: rgb(232 241 255 / 0.22);
	}

	.project-role {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	h2 {
		margin: 0;
		font-size: clamp(1.7rem, 4vw, 2.9rem);
		line-height: 0.95;
	}

	.project-copy {
		margin: 0;
		line-height: 1.56;
		color: rgb(232 241 255 / 0.9);
		max-width: 64ch;
	}

	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		gap: 0.45rem;
		flex-wrap: wrap;
	}

	li {
		padding: 0.32rem 0.56rem;
		border-radius: 999px;
		font-size: 0.74rem;
		border: 1px solid var(--line);
		color: var(--ink-soft);
		background: rgb(255 255 255 / 0.04);
	}

	.project-frame a {
		justify-self: start;
		display: inline-flex;
		text-decoration: none;
		font-weight: 700;
		color: var(--ink);
		padding: 0.5rem 0.8rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: rgb(255 255 255 / 0.08);
	}

	.theme-pink .project-frame {
		border-color: rgb(255 47 167 / 0.72);
	}

	.theme-pink h2 {
		color: var(--pink);
	}

	.theme-cyan .project-frame {
		border-color: rgb(27 230 255 / 0.72);
	}

	.theme-cyan h2 {
		color: var(--cyan);
	}

	.panel-lab {
		display: flex;
		align-items: center;
	}

	.lab-grid {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem;
	}

	.lab-card {
		padding: 0.9rem;
		border-radius: 18px;
		border: 2px solid var(--line);
		background: rgb(4 14 30 / 0.8);
		box-shadow: 0 20px 24px rgb(0 0 0 / 0.36);
	}

	h3 {
		margin: 0;
		font-size: clamp(1rem, 2.2vw, 1.6rem);
	}

	.lab-card p {
		margin: 0.55rem 0 0;
		line-height: 1.5;
		color: var(--ink-soft);
	}

	.tone-lime {
		border-color: rgb(204 255 55 / 0.72);
	}

	.tone-lime h3 {
		color: var(--acid);
	}

	.tone-amber {
		border-color: rgb(255 159 47 / 0.72);
	}

	.tone-amber h3 {
		color: var(--amber);
	}

	.tone-cyan {
		border-color: rgb(27 230 255 / 0.72);
	}

	.tone-cyan h3 {
		color: var(--cyan);
	}

	.tone-pink {
		border-color: rgb(255 47 167 / 0.72);
	}

	.tone-pink h3 {
		color: var(--pink);
	}

	.global-signal {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 10;
		overflow: hidden;
		border-top: 1px solid var(--line);
		background: rgb(4 12 24 / 0.88);
		backdrop-filter: blur(4px);
	}

	.global-signal-track {
		display: flex;
		width: max-content;
		gap: 0.65rem;
		padding: 0.58rem 0.7rem;
		will-change: transform;
		animation: ticker 30s linear infinite;
	}

	.global-signal-track span {
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.28rem 0.52rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--ink-soft);
		background: rgb(255 255 255 / 0.04);
	}

	.reveal {
		opacity: 0;
		transform: translateY(16px);
		animation: reveal 900ms cubic-bezier(0.2, 1, 0.2, 1) forwards;
	}

	.reveal-1 {
		animation-delay: 130ms;
	}

	.reveal-2 {
		animation-delay: 270ms;
	}

	.reveal-3 {
		animation-delay: 410ms;
	}

	@keyframes reveal {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes ticker {
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	@keyframes scan-shift {
		0% {
			transform: translateY(0);
		}
		100% {
			transform: translateY(5px);
		}
	}

	@keyframes wheel-dot {
		0% {
			opacity: 0;
			transform: translateY(0);
		}
		40% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			transform: translateY(0.5rem);
		}
	}

	@keyframes arrow-nudge {
		0%,
		100% {
			transform: translateX(0);
		}
		50% {
			transform: translateX(3px);
		}
	}

	@keyframes glitch-smooth-a {
		0%,
		100% {
			transform: translate3d(0.5px, 0, 0);
		}
		25% {
			transform: translate3d(-0.7px, -0.3px, 0);
