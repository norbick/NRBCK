---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		id: '01',
		name: 'm2_stage',
		subtitle: 'Event platform MVP',
		description:
			'Koncept platformy eventowej, skupiony na flow użytkownika, prostocie publikacji i testach użyteczności.',
		highlights: ['Flow UX', 'Landing events', 'MVP delivery'],
		repo: 'https://github.com/norbick/m2_stage',
		accent: 'accent-orange',
	},
	{
		id: '02',
		name: 'LooLoot',
		subtitle: 'Collectible drop concept',
		description:
			'Projekt wokół mechaniki dropów i kolekcjonowania przedmiotów, z naciskiem na estetykę i rytm interakcji.',
		highlights: ['Drop logic', 'Economy feel', 'Visual direction'],
		repo: 'https://github.com/norbick/LooLoot',
		accent: 'accent-cyan',
	},
];

const ticker = [
	'PORTFOLIO',
	'NO SAFE TEMPLATES',
	'ASTRO',
	'NRBCK',
	'DESIGN + CODE',
	'ITERATION',
];
---

<Layout title="NRBCK | Portfolio" description="Portfolio projektów NRBCK: m2_stage i LooLoot.">
	<main class="canvas">
		<div class="noise" aria-hidden="true"></div>

		<header class="masthead reveal reveal-1">
			<p class="micro">NRBCK / PORTFOLIO / VOL.01</p>
			<h1>
				<span>NO</span>
				<span>SAFE</span>
				<span>TEMPLATES</span>
			</h1>
			<p class="intro">
				To jest portfolio, które ma charakter. Ma być ostre, szybkie i zapamiętywalne. Bez generycznego
				układu kart i bez nudnego tła.
			</p>
			<div class="actions">
				<a class="btn btn-main" href="#projects">Zobacz projekty</a>
				<a class="btn btn-ghost" href="mailto:norbick@gmail.com">Kontakt</a>
			</div>
		</header>

		<section class="ticker reveal reveal-2" aria-label="Taśma stylu">
			<div class="ticker-track" aria-hidden="true">
				{[...ticker, ...ticker, ...ticker].map((word) => (
					<span>{word}</span>
				))}
			</div>
		</section>

		<section id="projects" class="showcase reveal reveal-3">
			{projects.map((project) => (
				<article class={`project ${project.accent}`}>
					<p class="project-id">{project.id}</p>
					<div class="project-main">
						<p class="project-subtitle">{project.subtitle}</p>
						<h2>{project.name}</h2>
						<p class="project-copy">{project.description}</p>
						<ul>
							{project.highlights.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
					<div class="project-side">
						<a href={project.repo} target="_blank" rel="noreferrer">Open Repo</a>
					</div>
				</article>
			))}
		</section>

		<section class="manifest reveal reveal-4">
			<p>Build loud. Build fast. Build weird. Then refine.</p>
		</section>
	</main>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@500;600&family=Space+Grotesk:wght@400;500;700&display=swap');

	:root {
		--bg-deep: #081521;
		--bg-mid: #132a40;
		--bg-soft: #163a57;
		--panel: rgb(7 20 34 / 0.75);
		--line: rgb(194 224 255 / 0.24);
		--ink: #e8f3ff;
		--ink-muted: #a8c2dc;
		--orange: #ff8a2f;
		--cyan: #17d8ff;
		--lime: #d9ff4e;
	}

	:global(body) {
		font-family: 'Space Grotesk', 'Trebuchet MS', sans-serif;
		color: var(--ink);
		background:
			radial-gradient(44rem 31rem at 12% 8%, rgb(255 138 47 / 0.25), transparent 68%),
			radial-gradient(35rem 28rem at 90% 18%, rgb(23 216 255 / 0.21), transparent 69%),
			linear-gradient(122deg, var(--bg-deep) 0%, var(--bg-mid) 52%, var(--bg-soft) 100%);
	}

	.canvas {
		position: relative;
		max-width: 1080px;
		margin: 0 auto;
		padding: 1.2rem 0.9rem 2.8rem;
	}

	.noise {
		position: fixed;
		inset: 0;
		pointer-events: none;
		background-image:
			radial-gradient(rgb(255 255 255 / 0.08) 0.45px, transparent 0.55px),
			radial-gradient(rgb(0 0 0 / 0.14) 0.35px, transparent 0.45px);
		background-size: 4px 4px, 6px 6px;
		opacity: 0.25;
		mix-blend-mode: overlay;
	}

	.masthead {
		position: relative;
		overflow: hidden;
		border-radius: 26px;
		padding: clamp(1rem, 2.4vw, 2rem);
		background:
			linear-gradient(140deg, rgb(8 21 33 / 0.82) 0%, rgb(10 36 56 / 0.8) 100%);
		border: 1px solid var(--line);
		box-shadow: 0 26px 44px rgb(2 7 12 / 0.4);
	}

	.masthead::after {
		content: '';
		position: absolute;
		width: 18rem;
		aspect-ratio: 1;
		top: -8rem;
		right: -5rem;
		background: radial-gradient(circle, rgb(23 216 255 / 0.36), transparent 65%);
	}

	.micro {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--ink-muted);
	}

	h1 {
		margin: 0.5rem 0 0;
		font-family: 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(2.1rem, 10vw, 6.6rem);
		line-height: 0.88;
		letter-spacing: 0.02em;
		text-wrap: balance;
	}

	h1 span {
		display: block;
	}

	h1 span:nth-child(1) {
		color: var(--lime);
	}

	h1 span:nth-child(2) {
		color: var(--orange);
	}

	h1 span:nth-child(3) {
		-webkit-text-stroke: 1px rgb(232 243 255 / 0.7);
		color: transparent;
	}

	.intro {
		margin: 1rem 0 0;
		max-width: 60ch;
		color: var(--ink-muted);
		line-height: 1.6;
	}

	.actions {
		margin-top: 1.2rem;
		display: flex;
		gap: 0.65rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		font-weight: 700;
		border-radius: 999px;
		padding: 0.62rem 1rem;
		transition: transform 160ms ease, box-shadow 180ms ease, background-color 160ms ease;
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn-main {
		background: var(--orange);
		color: #121212;
		box-shadow: 0 10px 18px rgb(255 138 47 / 0.32);
	}

	.btn-ghost {
		border: 1px solid var(--line);
		color: var(--ink);
		background: rgb(255 255 255 / 0.05);
	}

	.ticker {
		margin-top: 1rem;
		overflow: hidden;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: rgb(9 27 43 / 0.66);
	}

	.ticker-track {
		display: flex;
		width: max-content;
		gap: 0.7rem;
		padding: 0.72rem 0.6rem;
		animation: flow 22s linear infinite;
	}

	.ticker-track span {
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.76rem;
		padding: 0.34rem 0.62rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--ink-muted);
	}

	.showcase {
		margin-top: 1rem;
		display: grid;
		gap: 0.8rem;
	}

	.project {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 1rem;
		align-items: center;
		border-radius: 22px;
		padding: 1rem;
		border: 1px solid var(--line);
		background: var(--panel);
		backdrop-filter: blur(5px);
		transition: transform 220ms ease, border-color 220ms ease;
	}

	.project:hover {
		transform: translateY(-3px) rotate(-0.2deg);
	}

	.project-id {
		margin: 0;
		font-family: 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1;
		color: rgb(232 243 255 / 0.16);
	}

	.project-main {
		display: grid;
		gap: 0.6rem;
	}

	.project-subtitle {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.74rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--ink-muted);
	}

	h2 {
		margin: 0;
		font-size: clamp(1.7rem, 4vw, 2.8rem);
		line-height: 0.98;
	}

	.project-copy {
		margin: 0;
		line-height: 1.55;
		color: rgb(232 243 255 / 0.88);
		max-width: 62ch;
	}

	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		gap: 0.45rem;
		flex-wrap: wrap;
	}

	li {
		padding: 0.3rem 0.56rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		font-size: 0.74rem;
		color: var(--ink-muted);
	}

	.project-side a {
		display: inline-block;
		font-weight: 700;
		padding: 0.52rem 0.8rem;
		border-radius: 999px;
		text-decoration: none;
		border: 1px solid var(--line);
		color: var(--ink);
		background: rgb(255 255 255 / 0.06);
	}

	.project-side a:hover {
		background: rgb(255 255 255 / 0.14);
	}

	.accent-orange {
		border-color: rgb(255 138 47 / 0.52);
	}

	.accent-orange h2 {
		color: var(--orange);
	}

	.accent-cyan {
		border-color: rgb(23 216 255 / 0.52);
	}

	.accent-cyan h2 {
		color: var(--cyan);
	}

	.manifest {
		margin-top: 1rem;
		border: 1px solid var(--line);
		border-radius: 18px;
		padding: 0.95rem 1rem;
		background: rgb(8 24 38 / 0.76);
	}

	.manifest p {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.reveal {
		opacity: 0;
		transform: translateY(16px);
		animation: in 680ms cubic-bezier(0.2, 1, 0.2, 1) forwards;
	}

	.reveal-1 {
		animation-delay: 90ms;
	}

	.reveal-2 {
		animation-delay: 180ms;
	}

	.reveal-3 {
		animation-delay: 260ms;
	}

	.reveal-4 {
		animation-delay: 340ms;
	}

	@keyframes in {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes flow {
		to {
			transform: translateX(-33.333%);
		}
	}

	@media (max-width: 860px) {
		.project {
			grid-template-columns: 1fr;
			gap: 0.7rem;
		}

		.project-id {
			font-size: 2rem;
		}
	}

	@media (max-width: 560px) {
		.canvas {
			padding: 0.8rem 0.6rem 2rem;
		}

		.actions {
			gap: 0.5rem;
		}

		.btn {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		* {
			animation-duration: 1ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 1ms !important;
		}
	}
</style>
