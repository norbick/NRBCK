	.contact-intro {
		padding: 1rem;
	}

	.contact-kicker {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink-soft);
