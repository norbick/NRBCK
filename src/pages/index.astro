---
import Layout from '../layouts/Layout.astro';

type Localized = { pl: string; en: string };

type Project = {
	id: string;
	name: string;
	repo: string;
	theme: string;
	role: Localized;
	blurb: Localized;
	tags: Localized[];
	cta: Localized;
};

const projects: Project[] = [
	{
		id: '01',
		name: 'm2_stage',
		repo: 'https://github.com/norbick/m2_stage',
		theme: 'theme-blue',
		role: { pl: 'Strona dla projektu eventowego', en: 'Website for an event project' },
		blurb: {
			pl: 'Miejsce, w którym organizator pokazuje wydarzenie, a użytkownik od razu wie co, kiedy i jak dołączyć.',
			en: 'A place where the organizer presents the event and the user instantly sees what, when and how to join.',
		},
		tags: [
			{ pl: 'Czytelny układ', en: 'Clear layout' },
			{ pl: 'MVP', en: 'MVP' },
			{ pl: 'Szybkie wdrożenie', en: 'Fast launch' },
		],
		cta: { pl: 'Zobacz repozytorium', en: 'View repository' },
	},
	{
		id: '02',
		name: 'LooLoot',
		repo: 'https://github.com/norbick/LooLoot',
		theme: 'theme-orange',
		role: { pl: 'Projekt strony pod produkt cyfrowy', en: 'Website concept for a digital product' },
		blurb: {
			pl: 'Mocny, charakterystyczny styl z naciskiem na emocje, zrozumiały flow i szybkie przejście do działania.',
			en: 'A bold visual style focused on emotion, understandable flow and a fast path to action.',
		},
		tags: [
			{ pl: 'Wyrazisty styl', en: 'Bold style' },
			{ pl: 'Płynna nawigacja', en: 'Smooth navigation' },
			{ pl: 'Lepsza konwersja', en: 'Better conversion' },
		],
		cta: { pl: 'Zobacz repozytorium', en: 'View repository' },
	},
];

const sellingPoints: Localized[] = [
	{
		pl: 'Rozmawiam normalnie, bez technicznego bełkotu.',
		en: 'I keep communication simple, without technical buzzwords.',
	},
	{
		pl: 'Masz jedną osobę od designu i wdrożenia, więc wszystko idzie szybciej.',
		en: 'You get one person for both design and implementation, so everything moves faster.',
	},
	{
		pl: 'Strona ma nie tylko dobrze wyglądać, ale realnie przyciągać zapytania.',
		en: 'The site should not only look good but also attract real inquiries.',
	},
	{
		pl: 'Działamy etapami, więc szybko widzisz postęp i masz wpływ na kierunek.',
		en: 'We work in short iterations, so you see progress early and shape the direction.',
	},
	{
		pl: 'Styl dopasowuję do Twojej marki, a nie do gotowego szablonu.',
		en: 'The style is tailored to your brand, not to a random template.',
	},
	{
		pl: 'Masz jasny plan prac i konkretną informację co dalej.',
		en: 'You get a clear plan and concrete updates on what is next.',
	},
];

const signals: Localized[] = [
	{ pl: 'NRBCK PORTFOLIO', en: 'NRBCK PORTFOLIO' },
	{ pl: 'FREELANCE WEB DESIGN', en: 'FREELANCE WEB DESIGN' },
	{ pl: 'WEBFLOW + ASTRO', en: 'WEBFLOW + ASTRO' },
	{ pl: 'FROM IDEA TO LAUNCH', en: 'FROM IDEA TO LAUNCH' },
	{ pl: 'CLEAR MESSAGING', en: 'CLEAR MESSAGING' },
	{ pl: 'CLEAR FLOW', en: 'CLEAR FLOW' },
	{ pl: 'STRONG TYPOGRAPHY', en: 'STRONG TYPOGRAPHY' },
	{ pl: 'FAST ITERATION', en: 'FAST ITERATION' },
	{ pl: 'DESIGN THAT CONVERTS', en: 'DESIGN THAT CONVERTS' },
	{ pl: 'NO STIFF JARGON', en: 'NO STIFF JARGON' },
	{ pl: 'CONTACT AND DELIVERY', en: 'CONTACT AND DELIVERY' },
	{ pl: 'DEVELOPMENT READY', en: 'DEVELOPMENT READY' },
	{ pl: 'LIVE DEPLOY MODE', en: 'LIVE DEPLOY MODE' },
	{ pl: 'UI + WEBFLOW SYSTEMS', en: 'UI + WEBFLOW SYSTEMS' },
];

const signalTrack = [...signals, ...signals];
---

<Layout title="NRBCK | Portfolio" description="Portfolio NRBCK: design, Webflow i frontend.">
	<main class="shell">
		<script is:inline>
			(() => {
				const langs = navigator.languages?.length ? navigator.languages : [navigator.language || 'en'];
				const isPolish = langs.some((lang) => String(lang).toLowerCase().startsWith('pl'));
				const root = document.documentElement;
				root.classList.add(isPolish ? 'lang-pl' : 'lang-en');
				root.lang = isPolish ? 'pl' : 'en';
			})();
		</script>

		<div class="orb orb-a" aria-hidden="true"></div>
		<div class="orb orb-b" aria-hidden="true"></div>
		<div class="scroll-brighten" aria-hidden="true"></div>
		<div class="scanlines" aria-hidden="true"></div>
		<div class="vignette" aria-hidden="true"></div>

		<div class="scroll-hint" id="scroll-hint" aria-hidden="true">
			<span class="wheel"></span>
			<span class="arrow">→</span>
		</div>

		<section class="rail" id="horizontal-rail">
			<article class="panel panel-hero reveal reveal-1">
				<h1 class="headline">
					<span class="headline-line">
						<span class="headline-muted t-inline">
							<span data-l10n="pl">FREELANCE</span>
							<span data-l10n="en">FREELANCE</span>
						</span>
						<span class="glitch-line line-top" data-l10n="pl" data-text="WEB DESIGNER">WEB DESIGNER</span>
						<span class="glitch-line line-top" data-l10n="en" data-text="WEB DESIGNER">WEB DESIGNER</span>
					</span>
					<span class="headline-line">
						<span class="headline-muted amp">&amp;</span>
						<span class="glitch-line line-bottom" data-l10n="pl" data-text="WEBFLOW DEVELOPER">WEBFLOW DEVELOPER</span>
						<span class="glitch-line line-bottom" data-l10n="en" data-text="WEBFLOW DEVELOPER">WEBFLOW DEVELOPER</span>
					</span>
				</h1>

				<div class="hero-bottom">
					<p class="t-block hero-copy">
						<span data-l10n="pl">
							Pomagam firmom i twórcom zrobić stronę, która od pierwszego wejścia jasno pokazuje ofertę.
						</span>
						<span data-l10n="en">
							I help businesses and creators build websites that clearly explain the offer from the first second.
						</span>
					</p>
					<p class="t-block hero-copy">
						<span data-l10n="pl">
							Projektuję i wdrażam tak, żeby klient wiedział co robisz, dlaczego warto i jak się z Tobą skontaktować.
						</span>
						<span data-l10n="en">
							I design and build so people instantly know what you do, why it matters and how to contact you.
						</span>
					</p>
				</div>
			</article>

			<article id="projects" class="panel panel-projects reveal reveal-2">
				<div class="project-grid">
					{projects.map((project) => (
						<article class={`project-frame ${project.theme}`}>
							<p class="project-id">{project.id}</p>
							<p class="project-role t-inline">
								<span data-l10n="pl">{project.role.pl}</span>
								<span data-l10n="en">{project.role.en}</span>
							</p>
							<h2 class="project-title">{project.name}</h2>
							<p class="project-copy t-block">
								<span data-l10n="pl">{project.blurb.pl}</span>
								<span data-l10n="en">{project.blurb.en}</span>
							</p>
							<ul class="project-tags">
								{project.tags.map((tag) => (
									<li class="project-tag t-inline">
										<span data-l10n="pl">{tag.pl}</span>
										<span data-l10n="en">{tag.en}</span>
									</li>
								))}
							</ul>
							<a class="project-link t-inline" href={project.repo} target="_blank" rel="noreferrer">
								<span data-l10n="pl">{project.cta.pl}</span>
								<span data-l10n="en">{project.cta.en}</span>
							</a>
						</article>
					))}
				</div>
			</article>

			<article class="panel panel-value reveal reveal-3">
				<div class="value-shell">
					<div class="value-intro">
						<p class="value-kicker t-inline">
							<span data-l10n="pl">Dlaczego warto ze mną pracować</span>
							<span data-l10n="en">Why work with me</span>
						</p>
						<h3 class="value-title t-block">
							<span data-l10n="pl">Dlaczego klienci lubią ze mną pracować</span>
							<span data-l10n="en">Why clients like working with me</span>
						</h3>
						<p class="value-copy t-block">
							<span data-l10n="pl">
								Ma być prosto: Ty mówisz, czego potrzebujesz, a ja przekładam to na stronę, która pomaga zdobywać klientów.
							</span>
							<span data-l10n="en">
								It should feel simple: you explain what you need, and I turn it into a website that helps win clients.
							</span>
						</p>
					</div>

					<div class="selling-grid">
						{sellingPoints.map((point) => (
                            <article class="selling-card">
                                <p class="selling-copy t-block">
									<span data-l10n="pl">{point.pl}</span>
									<span data-l10n="en">{point.en}</span>
								</p>
							</article>
						))}
					</div>
				</div>
			</article>

			<article class="panel panel-contact reveal reveal-4">
				<div class="contact-shell">
					<div class="contact-intro">
						<p class="contact-kicker t-inline">
							<span data-l10n="pl">Kontakt</span>
							<span data-l10n="en">Contact</span>
						</p>
						<h3 class="contact-title t-block">
							<span data-l10n="pl">Masz pomysł na stronę? Napisz, czego potrzebujesz.</span>
							<span data-l10n="en">Have a website idea? Tell me what you need.</span>
						</h3>
						<p class="contact-copy t-block">
							<span data-l10n="pl">To wersja testowa: formularz otworzy maila z gotową treścią.</span>
							<span data-l10n="en">This is a demo version: the form opens your email app with a prefilled message.</span>
						</p>
					</div>

					<form class="contact-form" id="contact-form" novalidate>
						<label class="field">
							<span class="field-label t-inline">
								<span data-l10n="pl">Imię</span>
								<span data-l10n="en">Name</span>
							</span>
							<input type="text" name="name" required data-ph-pl="Jak masz na imię?" data-ph-en="What's your name?" />
						</label>

						<label class="field">
							<span class="field-label t-inline">
								<span data-l10n="pl">E-mail</span>
								<span data-l10n="en">Email</span>
							</span>
							<input type="email" name="email" required data-ph-pl="Na jaki adres mam odpisać?" data-ph-en="Where should I reply?" />
						</label>

						<label class="field">
							<span class="field-label t-inline">
								<span data-l10n="pl">Co ma robić Twoja strona?</span>
								<span data-l10n="en">What should your website do?</span>
							</span>
							<textarea name="message" rows="4" required data-ph-pl="Np. chcę więcej zapytań od klientów" data-ph-en="For example: I want more leads from my website"></textarea>
						</label>

						<label class="field">
							<span class="field-label t-inline">
								<span data-l10n="pl">Kiedy chcesz ruszyć?</span>
								<span data-l10n="en">When do you want to start?</span>
							</span>
							<select name="timeline" required>
								<option value="" selected disabled data-label-pl="Wybierz termin" data-label-en="Select timeline">Select timeline</option>
								<option value="asap" data-label-pl="Jak najszybciej" data-label-en="ASAP">ASAP</option>
								<option value="this-month" data-label-pl="W tym miesiącu" data-label-en="This month">This month</option>
								<option value="next-month" data-label-pl="W przyszłym miesiącu" data-label-en="Next month">Next month</option>
							</select>
						</label>

						<button class="contact-submit t-inline" type="submit">
							<span data-l10n="pl">Wyślij zapytanie</span>
							<span data-l10n="en">Send inquiry</span>
						</button>

						<p class="contact-status" id="contact-status" aria-live="polite"></p>
					</form>
				</div>
			</article>
		</section>

		<aside class="global-signal" aria-label="Signal rail">
			<div class="global-signal-track" aria-hidden="true">
				{signalTrack.map((item) => (
					<span class="signal-chip t-inline">
						<span data-l10n="pl">{item.pl}</span>
						<span data-l10n="en">{item.en}</span>
					</span>
				))}
			</div>
		</aside>
	</main>

		<script is:inline>
		const root = document.documentElement;
		const isPolish = root.classList.contains('lang-pl');

		document.querySelectorAll('[data-ph-pl]').forEach((node) => {
			const element = /** @type {HTMLElement} */ (node);
			const phPl = element.getAttribute('data-ph-pl') || '';
			const phEn = element.getAttribute('data-ph-en') || phPl;
			element.setAttribute('placeholder', isPolish ? phPl : phEn);
		});

		document.querySelectorAll('option[data-label-pl]').forEach((node) => {
			const option = /** @type {HTMLOptionElement} */ (node);
			const labelPl = option.getAttribute('data-label-pl') || option.textContent || '';
			const labelEn = option.getAttribute('data-label-en') || labelPl;
			option.textContent = isPolish ? labelPl : labelEn;
		});

		const rail = document.getElementById('horizontal-rail');
		const hint = document.getElementById('scroll-hint');
		const brighten = document.querySelector('.scroll-brighten');
		const desktop = window.matchMedia('(min-width: 921px)');

		if (rail) {
			const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
			let target = rail.scrollLeft;
			let current = rail.scrollLeft;
			let raf = 0;

			const updateProgress = () => {
				const max = rail.scrollWidth - rail.clientWidth;
				const progress = max > 0 ? rail.scrollLeft / max : 0;
				root.style.setProperty('--scroll-progress', progress.toFixed(4));
				if (brighten instanceof HTMLElement) {
					brighten.style.opacity = String(0.08 + progress * 0.9);
				}
			};

			const syncState = () => {
				target = rail.scrollLeft;
				current = rail.scrollLeft;
			};

			const updateHint = () => {
				if (!hint) return;
				if (!desktop.matches || rail.scrollLeft > 60) hint.classList.add('is-hidden');
				else hint.classList.remove('is-hidden');
			};

			const animate = () => {
				const diff = target - current;
				current += diff * 0.16;
				rail.scrollLeft = current;
				updateHint();
				updateProgress();
				if (Math.abs(diff) > 0.3) raf = requestAnimationFrame(animate);
				else {
					syncState();
					updateProgress();
					raf = 0;
				}
			};

			const moveBy = (delta) => {
				if (!raf) syncState();
				target = clamp(target + delta, 0, rail.scrollWidth - rail.clientWidth);
				if (!raf) raf = requestAnimationFrame(animate);
			};

			const onWheel = (event) => {
				if (!desktop.matches) return;
				const source = Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX;
				if (source === 0) return;
				event.preventDefault();
				const normalized = Math.sign(source) * Math.min(Math.abs(source), 95);
				moveBy(normalized * 2.2);
			};

			const onKey = (event) => {
				if (!desktop.matches) return;
				if (event.key === 'ArrowDown' || event.key === 'PageDown') {
					event.preventDefault();
					moveBy(window.innerWidth * 0.86);
				}
				if (event.key === 'ArrowUp' || event.key === 'PageUp') {
					event.preventDefault();
					moveBy(-window.innerWidth * 0.86);
				}
			};

			const onDesktopChange = () => {
				if (!desktop.matches) {
					if (raf) {
						cancelAnimationFrame(raf);
						raf = 0;
					}
					rail.scrollLeft = 0;
					target = 0;
					current = 0;
					root.style.setProperty('--scroll-progress', '0');
				}
				updateHint();
				updateProgress();
			};

			const onRailScroll = () => {
				updateHint();
				updateProgress();
				if (!raf) syncState();
			};

			window.addEventListener('wheel', onWheel, { passive: false });
			window.addEventListener('keydown', onKey);
			rail.addEventListener('scroll', onRailScroll, { passive: true });
			desktop.addEventListener('change', onDesktopChange);
			updateHint();
			updateProgress();
		}

		document.querySelectorAll('.selling-card').forEach((card) => {
			const element = /** @type {HTMLElement} */ (card);
			element.addEventListener('pointermove', (event) => {
				const e = /** @type {PointerEvent} */ (event);
				const rect = element.getBoundingClientRect();
				const x = (e.clientX - rect.left) / rect.width - 0.5;
				const y = (e.clientY - rect.top) / rect.height - 0.5;
				element.style.setProperty('--rx', `${(-y * 12).toFixed(2)}deg`);
				element.style.setProperty('--ry', `${(x * 14).toFixed(2)}deg`);
			});

			element.addEventListener('pointerleave', () => {
				element.style.setProperty('--rx', '0deg');
				element.style.setProperty('--ry', '0deg');
			});
		});

		const contactForm = document.getElementById('contact-form');
		const contactStatus = document.getElementById('contact-status');

		if (contactForm && contactStatus) {
			contactForm.addEventListener('submit', (event) => {
				event.preventDefault();
				const formData = new FormData(/** @type {HTMLFormElement} */ (contactForm));
				const name = String(formData.get('name') || '');
				const email = String(formData.get('email') || '');
				const message = String(formData.get('message') || '');
				const timeline = String(formData.get('timeline') || '');

				if (!name || !email || !message || !timeline) {
					contactStatus.textContent = isPolish
						? 'Uzupełnij proszę wszystkie pola.'
						: 'Please fill in all fields.';
					return;
				}

				const subject = isPolish ? `Nowe zapytanie od ${name}` : `New inquiry from ${name}`;
				const body = isPolish
					? `Imię: ${name}\nE-mail: ${email}\nTermin: ${timeline}\n\nOpis projektu:\n${message}`
					: `Name: ${name}\nEmail: ${email}\nTimeline: ${timeline}\n\nProject details:\n${message}`;

				const mailto = `mailto:norbick@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
				window.location.href = mailto;
				contactStatus.textContent = isPolish
					? 'Super, otwieram Twoją aplikację mailową.'
					: 'Great, opening your email app now.';
			});
		}
	</script>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@500;600&family=Sora:wght@400;600;700&display=swap');

	:root {
		--bg-0: #050811;
		--bg-1: #091126;
		--bg-2: #111b33;
		--ink: #f1f4ff;
		--ink-soft: #adb8d8;
		--line: rgb(143 166 224 / 0.34);
		--cyan: #49a9ff;
		--pink: #ff8450;
		--acid: #b2ff4f;
		--amber: #ffd066;
		--scroll-progress: 0;
	}

	:global(body) {
		font-family: 'Sora', 'Trebuchet MS', sans-serif;
		color: var(--ink);
		background:
			radial-gradient(44rem 34rem at 12% 10%, rgb(255 132 80 / 0.13), transparent 72%),
			radial-gradient(42rem 32rem at 88% 18%, rgb(73 169 255 / 0.15), transparent 74%),
			linear-gradient(132deg, var(--bg-0) 0%, var(--bg-1) 52%, var(--bg-2) 100%);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	@media (min-width: 921px) {
		:global(body) {
			overflow: hidden;
		}
	}

	[data-l10n] {
		display: none;
	}

	.t-inline > [data-l10n='en'] {
		display: inline;
	}

	.t-block > [data-l10n='en'] {
		display: block;
	}

	html.lang-pl .t-inline > [data-l10n='pl'] {
		display: inline;
	}

	html.lang-pl .t-inline > [data-l10n='en'] {
		display: none;
	}

	html.lang-pl .t-block > [data-l10n='pl'] {
		display: block;
	}

	html.lang-pl .t-block > [data-l10n='en'] {
		display: none;
	}

	.glitch-line[data-l10n] {
		display: none;
	}

	html.lang-en .glitch-line[data-l10n='en'],
	html.lang-pl .glitch-line[data-l10n='pl'],
	html:not(.lang-pl):not(.lang-en) .glitch-line[data-l10n='en'] {
		display: inline-block;
	}

	.shell {
		position: relative;
		min-height: 100vh;
	}

	.orb {
		position: fixed;
		width: min(46vw, 620px);
		height: min(46vw, 620px);
		border-radius: 50%;
		filter: blur(64px);
		pointer-events: none;
		z-index: 0;
		opacity: 0.35;
	}

	.orb-a {
		top: -18vh;
		left: -10vw;
		background: radial-gradient(circle, rgb(255 132 80 / 0.8), rgb(255 132 80 / 0));
		animation: orb-drift-a 16s ease-in-out infinite;
	}

	.orb-b {
		right: -12vw;
		bottom: -22vh;
		background: radial-gradient(circle, rgb(73 169 255 / 0.82), rgb(73 169 255 / 0));
		animation: orb-drift-b 18s ease-in-out infinite;
	}

	.scroll-brighten {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 0;
		background:
			radial-gradient(58rem 44rem at 86% 14%, rgb(255 196 122 / 0.72), transparent 70%),
			radial-gradient(56rem 42rem at 72% 78%, rgb(138 196 255 / 0.62), transparent 72%);
		mix-blend-mode: screen;
		opacity: calc(0.08 + (var(--scroll-progress) * 0.9));
		transition: opacity 100ms linear;
	}
	.scanlines {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 2;
		background: repeating-linear-gradient(
			to bottom,
			rgb(241 244 255 / 0.018) 0,
			rgb(241 244 255 / 0.018) 1px,
			rgb(0 0 0 / 0) 2px,
