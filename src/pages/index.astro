---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		name: 'm2_stage',
		subtitle: 'Event platform MVP',
		description:
			'Platform concept focused on event pages, flow testing and early UX validation.',
		tags: ['Astro', 'TypeScript', 'UI Experiments'],
		repo: 'https://github.com/norbick/m2_stage',
	},
	{
		name: 'LooLoot',
		subtitle: 'Collectible drop concept',
		description:
			'Visual concept around item drops and collectible mechanics, currently iterated as a private build.',
		tags: ['Web App', 'Product Design', 'Game Economy'],
		repo: 'https://github.com/norbick/LooLoot',
	},
];
---

<Layout title="NRBCK | Portfolio" description="Pierwsza iteracja portfolio z projektami m2_stage i LooLoot.">
	<main class="page">
		<header class="hero">
			<p class="eyebrow">NRBCK</p>
			<h1>Building digital products with clean logic and strong visuals.</h1>
			<p class="lead">
				This is iteration 1 of my portfolio. The goal for this version is simple: clear project cards,
				fast load, and a clean base we can expand later.
			</p>
			<div class="hero-actions">
				<a class="button button-primary" href="#projects">View projects</a>
				<a class="button button-ghost" href="mailto:norbick@gmail.com">Contact</a>
			</div>
		</header>

		<section id="projects" class="projects">
			<h2>Projects</h2>
			<div class="grid">
				{projects.map((project) => (
					<article class="card">
						<p class="card-subtitle">{project.subtitle}</p>
						<h3>{project.name}</h3>
						<p>{project.description}</p>
						<ul class="tags" aria-label={`Tech tags for ${project.name}`}>
							{project.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
						<a class="repo-link" href={project.repo} target="_blank" rel="noreferrer">Open repository</a>
					</article>
				))}
			</div>
		</section>

		<footer class="footer">
			<p>NRBCK portfolio - Astro + GitHub Pages</p>
		</footer>
	</main>
</Layout>

<style>
	:root {
		--bg: #f4efe5;
		--bg-soft: #fffaf2;
		--ink: #161616;
		--ink-soft: #545454;
		--line: #d9cfc1;
		--accent: #ef5e28;
		--accent-dark: #c44515;
	}

	:global(body) {
		font-family: 'Segoe UI', 'Trebuchet MS', sans-serif;
		color: var(--ink);
		background:
			radial-gradient(circle at 18% 12%, #ffe6b8 0%, transparent 35%),
			radial-gradient(circle at 88% 6%, #e5f7ff 0%, transparent 28%),
			var(--bg);
	}

	.page {
		max-width: 1040px;
		margin: 0 auto;
		padding: 2.2rem 1rem 3rem;
	}

	.hero {
		background: var(--bg-soft);
		border: 1px solid var(--line);
		border-radius: 20px;
		padding: 1.4rem;
		box-shadow: 0 18px 30px rgb(80 59 30 / 0.08);
	}

	.eyebrow {
		margin: 0 0 0.7rem;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--ink-soft);
	}

	h1 {
		margin: 0;
		font-size: clamp(1.8rem, 4vw, 3.2rem);
		line-height: 1.05;
		max-width: 22ch;
	}

	.lead {
		margin-top: 0.9rem;
		max-width: 64ch;
		color: var(--ink-soft);
		line-height: 1.55;
	}

	.hero-actions {
		display: flex;
		gap: 0.7rem;
		flex-wrap: wrap;
		margin-top: 1.2rem;
	}

	.button {
		display: inline-block;
		text-decoration: none;
		border-radius: 999px;
		padding: 0.62rem 1rem;
		font-weight: 700;
		border: 1px solid transparent;
		transition: transform 140ms ease, box-shadow 160ms ease, background-color 160ms ease;
	}

	.button:hover {
		transform: translateY(-1px);
	}

	.button-primary {
		background: var(--accent);
		color: #fff;
		box-shadow: 0 8px 16px rgb(239 94 40 / 0.26);
	}

	.button-primary:hover {
		background: var(--accent-dark);
	}

	.button-ghost {
		border-color: var(--line);
		color: var(--ink);
		background: #fff;
	}

	.projects {
		margin-top: 1.2rem;
	}

	h2 {
		font-size: 1.4rem;
		margin: 0 0 0.9rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.card {
		background: var(--bg-soft);
		border: 1px solid var(--line);
		border-radius: 16px;
		padding: 1rem;
		display: grid;
		gap: 0.75rem;
	}

	.card-subtitle {
		margin: 0;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-soft);
	}

	h3 {
		margin: 0;
		font-size: 1.45rem;
	}

	.card p {
		margin: 0;
		color: #3a3a3a;
		line-height: 1.5;
	}

	.tags {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.tags li {
		font-size: 0.76rem;
		padding: 0.34rem 0.58rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: #fff;
	}

	.repo-link {
		justify-self: start;
		font-weight: 700;
		color: var(--accent-dark);
		text-decoration: none;
	}

	.repo-link:hover {
		text-decoration: underline;
	}

	.footer {
		margin-top: 1.2rem;
		padding: 0.8rem 0;
		color: var(--ink-soft);
		font-size: 0.9rem;
	}

	@media (max-width: 760px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
