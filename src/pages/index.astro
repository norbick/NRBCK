---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		id: '01',
		name: 'm2_stage',
		role: 'Event platform MVP',
		blurb:
			'Koncept platformy eventowej: szybkie flow publikacji, czytelny funnel i testy UX na wczesnym etapie.',
		tags: ['UX Flow', 'MVP', 'Frontend Direction'],
		repo: 'https://github.com/norbick/m2_stage',
		lane: 'lane-a',
	},
	{
		id: '02',
		name: 'LooLoot',
		role: 'Collectible drop concept',
		blurb:
			'Projekt around drop mechanics i kolekcjonowanie przedmiotow, ze stylem mocno opartym o rytm i feedback.',
		tags: ['Drop Logic', 'Game Economy', 'Product Visuals'],
		repo: 'https://github.com/norbick/LooLoot',
		lane: 'lane-b',
	},
];

const signals = ['GLITCH MODE', 'KINETIC UI', 'NRBCK', 'ASTRO BUILD', 'SIGNAL ACTIVE', 'NO STATIC LAYOUT'];
---

<Layout title="NRBCK | Kinetic Glitch" description="Portfolio NRBCK w wersji glitch/kinetycznej.">
	<main class="frame">
		<div class="scanlines" aria-hidden="true"></div>
		<div class="vignette" aria-hidden="true"></div>

		<header class="hero reveal reveal-1">
			<p class="topline">NRBCK // SIGNAL FEED // MODE 02</p>
			<h1 class="glitch" data-text="KINETIC GLITCH">KINETIC GLITCH</h1>
			<p class="intro">
				Ten layout jest celowo agresywny wizualnie: wiecej ruchu, wiecej kontrastu i mniej bezpiecznego,
				powtarzalnego ukladu. Ma wygladac jak zyjacy sygnal.
			</p>
			<div class="cta">
				<a class="btn btn-main" href="#projects">Project Lanes</a>
				<a class="btn btn-ghost" href="mailto:norbick@gmail.com">Ping Me</a>
			</div>
		</header>

		<section class="signal reveal reveal-2" aria-label="Signal ticker">
			<div class="signal-track" aria-hidden="true">
				{[...signals, ...signals, ...signals].map((item, index) => (
					<span>{item} {String(index + 1).padStart(2, '0')}</span>
				))}
			</div>
		</section>

		<section id="projects" class="lanes reveal reveal-3">
			{projects.map((project) => (
				<article class={`lane ${project.lane}`}>
					<div class="lane-head">
						<p class="lane-id">{project.id}</p>
						<p class="lane-role">{project.role}</p>
					</div>
					<div class="lane-body">
						<h2>{project.name}</h2>
						<p>{project.blurb}</p>
						<ul aria-label={`Highlights for ${project.name}`}>
							{project.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					</div>
					<div class="lane-action">
						<a href={project.repo} target="_blank" rel="noreferrer">Open Repo</a>
					</div>
				</article>
			))}
		</section>

		<section class="footer-note reveal reveal-4">
			<p>Signal ends here. Next iteration: deeper case studies + custom domain.</p>
		</section>
	</main>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@500;600&family=Sora:wght@400;600;700&display=swap');

	:root {
		--bg-0: #02050b;
		--bg-1: #050d1b;
		--bg-2: #0b1630;
		--ink: #e8f1ff;
		--ink-soft: #98abc6;
		--line: rgb(150 185 232 / 0.28);
		--cyan: #16dbff;
		--pink: #ff2fa7;
		--acid: #c8ff35;
		--amber: #ff9a2f;
	}

	:global(body) {
		font-family: 'Sora', 'Trebuchet MS', sans-serif;
		color: var(--ink);
		background:
			radial-gradient(44rem 30rem at 8% 10%, rgb(255 47 167 / 0.18), transparent 68%),
			radial-gradient(42rem 33rem at 93% 12%, rgb(22 219 255 / 0.2), transparent 72%),
			linear-gradient(132deg, var(--bg-0) 0%, var(--bg-1) 45%, var(--bg-2) 100%);
	}

	.frame {
		position: relative;
		max-width: 1080px;
		margin: 0 auto;
		padding: 1.15rem 0.85rem 2.8rem;
	}

	.scanlines {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 0;
		background: repeating-linear-gradient(
			to bottom,
			rgb(255 255 255 / 0.02) 0,
			rgb(255 255 255 / 0.02) 1px,
			rgb(0 0 0 / 0) 2px,
			rgb(0 0 0 / 0) 4px
		);
		animation: scan-shift 6s linear infinite;
	}

	.vignette {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 0;
		box-shadow: inset 0 0 180px rgb(0 0 0 / 0.65);
	}

	.hero,
	.signal,
	.lanes,
	.footer-note {
		position: relative;
		z-index: 1;
	}

	.hero {
		border-radius: 24px;
		padding: clamp(1rem, 2.3vw, 2rem);
		border: 1px solid var(--line);
		background:
			linear-gradient(140deg, rgb(4 10 22 / 0.84) 0%, rgb(8 21 43 / 0.8) 100%);
		box-shadow:
			0 0 0 1px rgb(255 255 255 / 0.03),
			0 25px 50px rgb(1 4 10 / 0.5);
		overflow: hidden;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: -20% -10% auto auto;
		width: 18rem;
		height: 18rem;
		background: radial-gradient(circle, rgb(22 219 255 / 0.25), transparent 70%);
		transform: rotate(-18deg);
	}

	.topline {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.glitch {
		position: relative;
		display: inline-block;
		margin: 0.55rem 0 0;
		font-family: 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(2.2rem, 10vw, 6.8rem);
		line-height: 0.86;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--ink);
		text-shadow: 0 0 18px rgb(22 219 255 / 0.24);
	}

	.glitch::before,
	.glitch::after {
		content: attr(data-text);
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.glitch::before {
		color: var(--cyan);
		transform: translate(2px, 0);
		clip-path: polygon(0 2%, 100% 0, 100% 46%, 0 43%);
		animation: glitch-a 2.4s infinite linear alternate-reverse;
	}

	.glitch::after {
		color: var(--pink);
		transform: translate(-2px, 0);
		clip-path: polygon(0 58%, 100% 54%, 100% 100%, 0 100%);
		animation: glitch-b 1.8s infinite linear alternate-reverse;
	}

	.intro {
		margin: 1rem 0 0;
		max-width: 63ch;
		line-height: 1.62;
		color: var(--ink-soft);
	}

	.cta {
		display: flex;
		gap: 0.65rem;
		flex-wrap: wrap;
		margin-top: 1.2rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.62rem 1rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 700;
		transition: transform 150ms ease, box-shadow 180ms ease, background-color 160ms ease;
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn-main {
		background: linear-gradient(125deg, var(--pink), var(--amber));
		color: #0b0b0d;
		box-shadow: 0 10px 20px rgb(255 47 167 / 0.3);
	}

	.btn-ghost {
		border: 1px solid var(--line);
		color: var(--ink);
		background: rgb(255 255 255 / 0.04);
	}

	.signal {
		margin-top: 0.95rem;
		border-radius: 999px;
		overflow: hidden;
		border: 1px solid var(--line);
		background: rgb(8 19 38 / 0.7);
	}

	.signal-track {
		display: flex;
		width: max-content;
		gap: 0.62rem;
		padding: 0.72rem 0.55rem;
		animation: ticker 14s linear infinite;
	}

	.signal-track span {
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.32rem 0.58rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--ink-soft);
		background: rgb(255 255 255 / 0.03);
	}

	.lanes {
		margin-top: 0.95rem;
		display: grid;
		gap: 0.78rem;
	}

	.lane {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 1rem;
		align-items: center;
		padding: 1rem;
		border-radius: 20px;
		border: 1px solid var(--line);
		background: rgb(5 16 32 / 0.78);
		backdrop-filter: blur(4px);
		transform-origin: center left;
		transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
	}

	.lane:hover {
		transform: translateY(-3px) skewX(-1.1deg);
		box-shadow: 0 18px 28px rgb(0 0 0 / 0.35);
	}

	.lane-a {
		border-color: rgb(255 47 167 / 0.58);
	}

	.lane-b {
		border-color: rgb(22 219 255 / 0.58);
	}

	.lane-head {
		display: grid;
		gap: 0.34rem;
	}

	.lane-id {
		margin: 0;
		font-family: 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(1.8rem, 4vw, 2.7rem);
		line-height: 1;
		color: rgb(232 241 255 / 0.18);
	}

	.lane-role {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.lane-body {
		display: grid;
		gap: 0.62rem;
	}

	h2 {
		margin: 0;
		font-size: clamp(1.65rem, 4vw, 2.7rem);
		line-height: 0.95;
	}

	.lane-a h2 {
		color: var(--pink);
	}

	.lane-b h2 {
		color: var(--cyan);
	}

	.lane-body p {
		margin: 0;
		color: rgb(232 241 255 / 0.9);
		line-height: 1.56;
		max-width: 64ch;
	}

	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		gap: 0.45rem;
		flex-wrap: wrap;
	}

	li {
		padding: 0.3rem 0.55rem;
		border-radius: 999px;
		font-size: 0.73rem;
		color: var(--ink-soft);
		border: 1px solid var(--line);
		background: rgb(255 255 255 / 0.03);
	}

	.lane-action a {
		display: inline-block;
		padding: 0.54rem 0.82rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 700;
		color: var(--ink);
		border: 1px solid var(--line);
		background: rgb(255 255 255 / 0.06);
	}

	.lane-action a:hover {
		background: rgb(255 255 255 / 0.16);
	}

	.footer-note {
		margin-top: 0.95rem;
		padding: 0.88rem 1rem;
		border-radius: 16px;
		border: 1px solid var(--line);
		background: rgb(5 15 30 / 0.74);
	}

	.footer-note p {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.76rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-soft);
	}

	.reveal {
		opacity: 0;
		transform: translateY(14px);
		animation: reveal 620ms cubic-bezier(0.2, 1, 0.2, 1) forwards;
	}

	.reveal-1 {
		animation-delay: 80ms;
	}

	.reveal-2 {
		animation-delay: 170ms;
	}

	.reveal-3 {
		animation-delay: 250ms;
	}

	.reveal-4 {
		animation-delay: 340ms;
	}

	@keyframes reveal {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes ticker {
		to {
			transform: translateX(-33.333%);
		}
	}

	@keyframes scan-shift {
		0% {
			transform: translateY(0);
		}
		100% {
			transform: translateY(4px);
		}
	}

	@keyframes glitch-a {
		0% {
			transform: translate(2px, 0);
		}
		20% {
			transform: translate(-1px, -1px);
		}
		40% {
			transform: translate(3px, 1px);
		}
		60% {
			transform: translate(-2px, 0);
		}
		80% {
			transform: translate(1px, -1px);
		}
		100% {
			transform: translate(2px, 0);
		}
	}

	@keyframes glitch-b {
		0% {
			transform: translate(-2px, 0);
		}
		20% {
			transform: translate(1px, 1px);
		}
		40% {
			transform: translate(-3px, -1px);
		}
		60% {
			transform: translate(2px, 0);
		}
		80% {
			transform: translate(-1px, 1px);
		}
		100% {
			transform: translate(-2px, 0);
		}
	}

	@media (max-width: 860px) {
		.lane {
			grid-template-columns: 1fr;
			gap: 0.74rem;
		}

		.lane-head {
			grid-auto-flow: column;
			justify-content: start;
			align-items: baseline;
			column-gap: 0.8rem;
		}
	}

	@media (max-width: 560px) {
		.frame {
			padding: 0.8rem 0.6rem 2rem;
		}

		.cta {
			gap: 0.5rem;
		}

		.btn {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		* {
			animation-duration: 1ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 1ms !important;
		}
	}
</style>
