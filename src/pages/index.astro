					padBus.gain.setValueAtTime(Math.max(padBus.gain.value, 0.0001), time);
					padBus.gain.linearRampToValueAtTime(0.034, time + 0.42);
					padBus.gain.linearRampToValueAtTime(0.026, time + barSeconds * 0.92);
