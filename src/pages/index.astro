---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		id: '01',
		name: 'm2_stage',
		role: 'Event platform MVP',
		blurb:
			'Koncept platformy eventowej: szybkie flow publikacji, czytelny funnel i testy UX na wczesnym etapie.',
		tags: ['UX Flow', 'MVP', 'Frontend Direction'],
		repo: 'https://github.com/norbick/m2_stage',
		theme: 'theme-blue',
	},
	{
		id: '02',
		name: 'LooLoot',
		role: 'Collectible drop concept',
		blurb:
			'Projekt around drop mechanics i kolekcjonowanie przedmiotow, ze stylem opartym o rytm i mocny feedback.',
		tags: ['Drop Logic', 'Game Economy', 'Product Visuals'],
		repo: 'https://github.com/norbick/LooLoot',
		theme: 'theme-orange',
	},
];

const sellingPoints = [
	{
		title: 'Design, ktory sprzedaje',
		text: 'Lacze estetyke z celem produktu: kazdy ekran ma prowadzic uzytkownika do decyzji.',
	},
	{
		title: 'Silny kierunek wizualny',
		text: 'Buduje wyrazisty styl marki zamiast bezpiecznych, generycznych szablonow.',
	},
	{
		title: 'Szybkie iteracje',
		text: 'Pracuje w krotkich petlach: pomysl -> prototyp -> test -> poprawka -> deploy.',
	},
	{
		title: 'Frontend + UX w jednym',
		text: 'Decyzje projektowe i implementacje sa spojne, bo projektuje i koduje to sam.',
	},
	{
		title: 'Porzadek informacji',
		text: 'Ukladam tresc tak, by user od razu wiedzial co jest wazne i co zrobic dalej.',
	},
	{
		title: 'Komunikacja bez chaosu',
		text: 'Jasno tlumacze decyzje i priorytety, dzieki czemu projekt idzie do przodu bez tarcia.',
	},
];

const signals = [
	'NRBCK PORTFOLIO',
	'FREELANCE UI DESIGN',
	'WEBFLOW + ASTRO',
	'VISUAL DIRECTION',
	'UX FLOW THINKING',
	'FAST ITERATION LOOP',
	'BRAND ENERGY',
	'PRODUCT MINDSET',
	'CLEAR USER PATHS',
	'CREATIVE ENGINEERING',
	'MOTION WITH PURPOSE',
	'NO TEMPLATE VIBES',
	'STRONG TYPOGRAPHY',
	'DESIGN THAT CONVERTS',
	'DEVELOPMENT READY',
	'LIVE DEPLOY MODE',
	'RELIABLE EXECUTION',
	'BUSINESS-ORIENTED UI',
	'VISUAL STORYTELLING',
	'PIXEL + CODE CONTROL',
];

const signalTrack = [...signals, ...signals];
---

<Layout title="NRBCK | Portfolio" description="Portfolio NRBCK: web design, Webflow i frontend implementation.">
	<main class="shell">
		<div class="scanlines" aria-hidden="true"></div>
		<div class="vignette" aria-hidden="true"></div>

		<div class="scroll-hint" id="scroll-hint">
			<span class="wheel" aria-hidden="true"></span>
			<span class="hint-text">Desktop: scroll down moves right</span>
			<span class="arrow" aria-hidden="true">→</span>
		</div>

		<section class="rail" id="horizontal-rail">
			<article class="panel panel-hero reveal reveal-1">
				<p class="eyebrow">Portfolio 2026 / NRBCK</p>

				<h1 class="headline">
					<span class="headline-row">
						<span class="headline-muted">FREELANCE</span>
						<span class="glitch-line line-top" data-text="WEB DESIGNER">WEB DESIGNER</span>
					</span>
					<span class="headline-row">
						<span class="headline-muted amp">&amp;</span>
						<span class="glitch-line line-bottom" data-text="WEBFLOW DEVELOPER">WEBFLOW DEVELOPER</span>
					</span>
				</h1>

				<div class="hero-bottom">
					<p>
						Projektuje i koduje strony, ktore wygladaja mocno, prowadza usera jasno i realnie wspieraja cel
						biznesowy.
					</p>
					<div>
						<p>
							Moj focus: czytelny UX, wyrazista typografia, sensowna hierarchia tresci i szybkie wdrozenie bez
							chaosu.
						</p>
						<a class="hero-link" id="open-projects" href="#projects">Open project lanes</a>
					</div>
				</div>
			</article>

			{projects.map((project) => (
				<article id={project.id === '01' ? 'projects' : undefined} class={`panel panel-project ${project.theme}`}>
					<div class="project-frame">
						<p class="project-id">{project.id}</p>
						<p class="project-role">{project.role}</p>
						<h2 class="project-title">{project.name}</h2>
						<p class="project-copy">{project.blurb}</p>
						<ul class="project-tags" aria-label={`Highlights for ${project.name}`}>
							{project.tags.map((tag) => (
								<li class="project-tag">{tag}</li>
							))}
						</ul>
						<a class="project-link" href={project.repo} target="_blank" rel="noreferrer">Open Repo</a>
					</div>
				</article>
			))}

			<article class="panel panel-value reveal reveal-3">
				<div class="value-shell">
					<div class="value-intro">
						<p class="value-kicker">Why work with me</p>
						<h3 class="value-title">Designer, ktory mysli produktowo i dowozi</h3>
						<p class="value-copy">
							Nie projektuje "ladnych ekranow" dla samego wygladu. Celem jest zawsze efekt: lepsze zrozumienie
							oferty, wieksze zaufanie do marki i czytelna sciezka dzialania.
						</p>
					</div>

					<div class="selling-grid">
						{sellingPoints.map((point) => (
							<article class="selling-card">
								<h4 class="selling-title">{point.title}</h4>
								<p class="selling-copy">{point.text}</p>
							</article>
						))}
					</div>
				</div>
			</article>
		</section>

		<aside class="global-signal" aria-label="Signal rail">
			<div class="global-signal-track" aria-hidden="true">
				{signalTrack.map((item) => (
					<span>{item}</span>
				))}
			</div>
		</aside>
	</main>

	<script is:inline>
		const rail = document.getElementById('horizontal-rail');
		const hint = document.getElementById('scroll-hint');
		const projectsTrigger = document.getElementById('open-projects');
		const projectsPanel = document.getElementById('projects');
		const desktop = window.matchMedia('(min-width: 921px)');

		if (rail) {
			const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
			let target = rail.scrollLeft;
			let current = rail.scrollLeft;
			let raf = 0;

			const syncState = () => {
				target = rail.scrollLeft;
				current = rail.scrollLeft;
			};

			const updateHint = () => {
				if (!hint) return;
				if (!desktop.matches || rail.scrollLeft > 60) hint.classList.add('is-hidden');
				else hint.classList.remove('is-hidden');
			};

			const animate = () => {
				const diff = target - current;
				current += diff * 0.16;
				rail.scrollLeft = current;
				updateHint();

				if (Math.abs(diff) > 0.3) {
					raf = requestAnimationFrame(animate);
				} else {
					syncState();
					raf = 0;
				}
			};

			const moveBy = (delta) => {
				if (!raf) syncState();
				target = clamp(target + delta, 0, rail.scrollWidth - rail.clientWidth);
				if (!raf) raf = requestAnimationFrame(animate);
			};

			const moveTo = (left) => {
				if (!raf) syncState();
				target = clamp(left, 0, rail.scrollWidth - rail.clientWidth);
				if (!raf) raf = requestAnimationFrame(animate);
			};

			const onWheel = (event) => {
				if (!desktop.matches) return;
				const source = Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX;
				if (source === 0) return;
				event.preventDefault();
				const normalized = Math.sign(source) * Math.min(Math.abs(source), 100);
				moveBy(normalized * 2.1);
			};

			const onKey = (event) => {
				if (!desktop.matches) return;
				if (event.key === 'ArrowDown' || event.key === 'PageDown') {
					event.preventDefault();
					moveBy(window.innerWidth * 0.86);
				}
				if (event.key === 'ArrowUp' || event.key === 'PageUp') {
					event.preventDefault();
					moveBy(-window.innerWidth * 0.86);
				}
			};

			const onDesktopChange = () => {
				if (!desktop.matches) {
					if (raf) {
						cancelAnimationFrame(raf);
						raf = 0;
					}
					rail.scrollLeft = 0;
					target = 0;
					current = 0;
				}
				updateHint();
			};

			const onProjectsClick = (event) => {
				if (!projectsPanel || !desktop.matches) return;
				event.preventDefault();
				moveTo(projectsPanel.offsetLeft);
			};

			const onRailScroll = () => {
				updateHint();
				if (!raf) syncState();
			};

			window.addEventListener('wheel', onWheel, { passive: false });
			window.addEventListener('keydown', onKey);
			rail.addEventListener('scroll', onRailScroll, { passive: true });
			desktop.addEventListener('change', onDesktopChange);
			projectsTrigger?.addEventListener('click', onProjectsClick);
			updateHint();
		}
	</script>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@500;600&family=Sora:wght@400;600;700&display=swap');

	:root {
		--bg-0: #e9edf5;
		--bg-1: #d6deea;
		--bg-2: #f6f8fc;
		--ink: #111722;
		--ink-soft: #51607a;
		--line: rgb(17 23 34 / 0.24);
		--cyan: #2468ff;
		--pink: #ff6432;
		--acid: #8eb700;
		--amber: #0ea9a1;
	}

	:global(body) {
		font-family: 'Sora', 'Trebuchet MS', sans-serif;
		color: var(--ink);
		background:
			radial-gradient(42rem 30rem at 12% 12%, rgb(255 100 50 / 0.18), transparent 70%),
			radial-gradient(38rem 28rem at 88% 18%, rgb(36 104 255 / 0.2), transparent 72%),
			linear-gradient(132deg, var(--bg-0) 0%, var(--bg-1) 48%, var(--bg-2) 100%);
	}

	@media (min-width: 921px) {
		:global(body) {
			overflow: hidden;
		}
	}

	.shell {
		position: relative;
		min-height: 100vh;
	}

	.scanlines {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 2;
		background: repeating-linear-gradient(
			to bottom,
			rgb(17 23 34 / 0.02) 0,
			rgb(17 23 34 / 0.02) 1px,
			rgb(255 255 255 / 0) 2px,
			rgb(255 255 255 / 0) 4px
		);
		animation: scan-shift 14s linear infinite;
	}

	.vignette {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 1;
		box-shadow: inset 0 0 140px rgb(16 24 38 / 0.12);
	}

	.scroll-hint {
		position: fixed;
		right: 1rem;
		bottom: 3.5rem;
		z-index: 9;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.56rem 0.84rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgb(248 251 255 / 0.76);
		backdrop-filter: blur(4px);
		transition: opacity 260ms ease, transform 260ms ease;
	}

	.scroll-hint.is-hidden {
		opacity: 0;
		transform: translateY(14px);
		pointer-events: none;
	}

	.wheel {
		display: inline-block;
		width: 0.85rem;
		height: 1.25rem;
		border-radius: 999px;
		border: 1px solid var(--ink-soft);
		position: relative;
	}

	.wheel::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0.2rem;
		width: 0.18rem;
		height: 0.22rem;
		margin-left: -0.09rem;
		border-radius: 999px;
		background: var(--ink-soft);
		animation: wheel-dot 2s ease infinite;
	}

	.hint-text {
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.arrow {
		font-size: 0.95rem;
		animation: arrow-nudge 2s ease infinite;
	}

	.rail {
		position: relative;
		z-index: 4;
		display: flex;
		height: 100vh;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: none;
		gap: 1.2rem;
		padding: 1rem 1rem 4.2rem;
		scrollbar-width: none;
	}

	.rail::-webkit-scrollbar {
		display: none;
	}

	.panel {
		flex: 0 0 calc(100vw - 2rem);
		height: calc(100vh - 5.2rem);
		padding: clamp(0.9rem, 2vw, 1.6rem);
		overflow: visible;
	}

	.panel-hero {
		display: grid;
		grid-template-rows: auto 1fr auto;
	}

	.eyebrow {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.74rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.headline {
		margin: 0.8rem 0 0;
		font-family: 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(2.2rem, 8.6vw, 5.8rem);
		line-height: 0.9;
		letter-spacing: 0.01em;
		display: grid;
		gap: 0.12em;
	}

	.headline-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.2em;
	}

	.headline-muted {
		color: rgb(17 23 34 / 0.45);
	}

	.headline-muted.amp {
		color: rgb(17 23 34 / 0.6);
	}

	.glitch-line {
		position: relative;
		display: inline-block;
		text-transform: uppercase;
		color: var(--ink);
		animation: title-pulse 7s ease-in-out infinite;
	}

	.glitch-line::before,
	.glitch-line::after {
		content: attr(data-text);
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0.88;
		will-change: transform;
	}

	.line-top::before {
		color: var(--pink);
		animation: glitch-a 8s linear infinite;
	}

	.line-top::after {
		color: var(--cyan);
		animation: glitch-b 9.4s linear infinite;
	}

	.line-bottom::before {
		color: var(--amber);
		animation: glitch-c 7.6s linear infinite;
	}

	.line-bottom::after {
		color: var(--acid);
		animation: glitch-d 10.2s linear infinite;
	}

	.hero-bottom {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.2rem;
		align-items: end;
	}

	.hero-bottom p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.58;
		color: var(--ink-soft);
		max-width: 62ch;
	}

	.hero-link {
		margin-top: 0.9rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.56rem 0.96rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		text-decoration: none;
		font-weight: 700;
		font-size: 0.9rem;
		color: #ffffff;
		background: linear-gradient(125deg, var(--pink), var(--cyan));
		box-shadow: 0 12px 22px rgb(36 104 255 / 0.25);
	}

	.panel-project {
		display: grid;
		place-items: center;
	}

	.project-frame {
		width: min(900px, 88%);
		padding: 1.14rem;
		border-radius: 22px;
		border: 1px solid var(--line);
		background: rgb(255 255 255 / 0.68);
		backdrop-filter: blur(2px);
		box-shadow: 0 18px 34px rgb(18 28 46 / 0.12);
		display: grid;
		gap: 0.75rem;
		transition: transform 220ms ease, box-shadow 220ms ease;
	}

	.project-frame:hover {
		transform: translateY(-6px);
		box-shadow: 0 22px 38px rgb(18 28 46 / 0.16);
	}

	.project-id {
		margin: 0;
		font-family: 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(1.7rem, 4vw, 2.8rem);
		line-height: 1;
		color: rgb(17 23 34 / 0.22);
	}

	.project-role {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.73rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.project-title {
		margin: 0;
		font-size: clamp(1.6rem, 4vw, 2.8rem);
		line-height: 0.95;
	}

	.project-copy {
		margin: 0;
		line-height: 1.58;
		color: rgb(17 23 34 / 0.84);
		max-width: 64ch;
	}

	.project-tags {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		gap: 0.45rem;
		flex-wrap: wrap;
	}

	.project-tag {
		padding: 0.32rem 0.56rem;
		border-radius: 999px;
		font-size: 0.74rem;
		border: 1px solid var(--line);
		color: var(--ink-soft);
		background: rgb(255 255 255 / 0.6);
	}

	.project-link {
		justify-self: start;
		display: inline-flex;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.86rem;
		color: #ffffff;
		padding: 0.52rem 0.86rem;
		border-radius: 999px;
		border: 1px solid transparent;
		background: linear-gradient(135deg, rgb(17 23 34 / 0.9), rgb(36 104 255 / 0.9));
	}

	.theme-blue .project-frame {
		border-color: rgb(36 104 255 / 0.42);
	}

	.theme-blue .project-title {
		color: var(--cyan);
	}

	.theme-orange .project-frame {
		border-color: rgb(255 100 50 / 0.48);
	}

	.theme-orange .project-title {
		color: var(--pink);
	}

	.panel-value {
		display: flex;
		align-items: center;
	}

	.value-shell {
		width: min(1060px, 100%);
		display: grid;
		grid-template-columns: 1.2fr 1.8fr;
		gap: 1rem;
	}

	.value-intro {
		padding: 1rem;
		border: 1px solid var(--line);
		border-radius: 18px;
		background: rgb(255 255 255 / 0.66);
		box-shadow: 0 14px 28px rgb(18 28 46 / 0.1);
	}

	.value-kicker {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.value-title {
		margin: 0.52rem 0 0;
		font-size: clamp(1.28rem, 2.4vw, 2.05rem);
		line-height: 1.06;
		color: var(--ink);
	}

	.value-copy {
		margin: 0.7rem 0 0;
		line-height: 1.58;
		color: var(--ink-soft);
	}

	.selling-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem;
	}

	.selling-card {
		padding: 0.9rem;
		border-radius: 16px;
		border: 1px solid var(--line);
		background: rgb(255 255 255 / 0.72);
		box-shadow: 0 12px 20px rgb(18 28 46 / 0.08);
	}

	.selling-title {
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.2;
		color: var(--ink);
	}

	.selling-copy {
		margin: 0.5rem 0 0;
		line-height: 1.5;
		color: var(--ink-soft);
	}

	.global-signal {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 10;
		overflow: hidden;
		border-top: 1px solid var(--line);
		background: rgb(245 248 253 / 0.88);
		backdrop-filter: blur(6px);
	}

	.global-signal-track {
		display: flex;
		width: max-content;
		gap: 0.65rem;
		padding: 0.58rem 0.7rem;
		will-change: transform;
		animation: ticker 28s linear infinite;
	}

	.global-signal-track span {
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.69rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.28rem 0.52rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--ink-soft);
		background: rgb(255 255 255 / 0.64);
	}

	.reveal {
		opacity: 0;
		transform: translateY(16px);
		animation: reveal 900ms cubic-bezier(0.2, 1, 0.2, 1) forwards;
	}

	.reveal-1 {
		animation-delay: 120ms;
	}

	.reveal-3 {
		animation-delay: 360ms;
	}

	@keyframes reveal {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes ticker {
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	@keyframes scan-shift {
		0% {
			transform: translateY(0);
		}
		100% {
			transform: translateY(5px);
		}
	}

	@keyframes wheel-dot {
		0% {
			opacity: 0;
			transform: translateY(0);
		}
		40% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			transform: translateY(0.5rem);
		}
	}

	@keyframes arrow-nudge {
		0%,
		100% {
			transform: translateX(0);
		}
		50% {
			transform: translateX(3px);
		}
	}

	@keyframes title-pulse {
		0%,
		100% {
			text-shadow: 0 0 0 rgb(36 104 255 / 0.12);
		}
		50% {
			text-shadow: 0 0 14px rgb(36 104 255 / 0.25);
		}
	}

	@keyframes glitch-a {
		0%,
		100% {
			transform: translate3d(-1.8px, 0, 0);
			opacity: 0.9;
