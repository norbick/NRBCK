				const scheduleChord = (time, chord) => {
					if (!padVoices.length || !padBus || !padFilter || !bassOsc) return;
					const spread = [chord.notes[0] - 12, chord.notes[1], chord.notes[2], chord.notes[3], chord.notes[4] + 12];

					padVoices.forEach((voice, index) => {
