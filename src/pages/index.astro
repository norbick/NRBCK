	/* Full retro-futuristic mode (variant 1) */
	:root {
		--bg-0: #06000f;
		--bg-1: #0c0522;
		--bg-2: #170a34;
		--ink: #f8f3ff;
		--ink-soft: #cbc4ec;
		--line: rgb(197 170 255 / 0.28);
		--cyan: #4af4ff;
		--pink: #ff4fd3;
		--acid: #dbff57;
		--amber: #ffba66;
		--mint: #7fffe7;
		--violet: #9d8bff;
	}

	:global(body) {
		background:
			radial-gradient(110rem 74rem at 10% 8%, rgb(255 74 169 / 0.22), transparent 64%),
			radial-gradient(90rem 66rem at 92% 16%, rgb(74 244 255 / 0.18), transparent 66%),
			radial-gradient(90rem 62rem at 52% 102%, rgb(255 176 85 / 0.2), transparent 68%),
			linear-gradient(164deg, var(--bg-0) 0%, var(--bg-1) 44%, var(--bg-2) 100%);
	}

	.shell::before {
		content: '';
		position: fixed;
		inset: -10vh -8vw;
		pointer-events: none;
		z-index: 0;
		background:
			linear-gradient(to top, rgb(5 2 14 / 0.96) 0%, rgb(5 2 14 / 0.42) 29%, transparent 58%),
			repeating-linear-gradient(90deg, rgb(161 129 255 / 0.17) 0 1px, transparent 1px 72px),
			repeating-linear-gradient(0deg, rgb(95 243 255 / 0.15) 0 1px, transparent 1px 54px);
		transform-origin: center bottom;
		transform: perspective(1100px) rotateX(64deg) translateY(37vh) scale(1.34);
		opacity: 0.48;
		animation: retro-grid-pulse 9.2s var(--ease-organic) infinite;
	}

	.shell::after {
		content: '';
		position: fixed;
		left: 50%;
		bottom: 20vh;
		width: clamp(18rem, 46vw, 48rem);
		aspect-ratio: 1 / 1;
		translate: -50% 0;
		pointer-events: none;
		z-index: 0;
		border-radius: 999px;
		background:
			radial-gradient(circle at 50% 40%, rgb(255 238 176 / 0.9) 0%, rgb(255 137 212 / 0.55) 36%, rgb(161 129 255 / 0.18) 74%, transparent 84%),
			repeating-linear-gradient(to bottom, rgb(255 177 99 / 0.55) 0 2px, transparent 2px 8px);
		mix-blend-mode: screen;
		filter: blur(0.2px) saturate(1.12);
		opacity: calc(0.48 + (var(--scroll-progress) * 0.28));
		animation: retro-horizon-float 13s var(--ease-organic) infinite;
	}

	.project-preview-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		opacity: 0;
		pointer-events: none;
		overflow: hidden;
		border-radius: inherit;
		transition: opacity 420ms var(--ease-organic);
	}

	.project-preview-bg.is-active {
		opacity: 1;
	}

	.project-preview-frame {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
		opacity: 0;
		transform: scale(1.035);
		transform-origin: center center;
		filter: saturate(1.06) contrast(1.04);
		transition: opacity 460ms var(--ease-organic), transform 520ms var(--ease-organic);
	}

	.project-preview-frame.is-active {
		opacity: 0.48;
		transform: scale(1);
	}

	.project-preview-overlay {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(74rem 48rem at 16% 16%, rgb(255 78 199 / 0.18), transparent 68%),
			radial-gradient(80rem 52rem at 86% 76%, rgb(74 244 255 / 0.16), transparent 70%),
			linear-gradient(145deg, rgb(4 2 14 / 0.9), rgb(7 13 36 / 0.84));
	}

	.orb {
		filter: blur(78px) saturate(1.2);
		opacity: 0.32;
	}

	.orb-a {
		background: radial-gradient(circle, rgb(255 79 211 / 0.88), rgb(255 79 211 / 0));
	}

	.orb-b {
		background: radial-gradient(circle, rgb(74 244 255 / 0.9), rgb(74 244 255 / 0));
	}

	.scanlines {
		background: repeating-linear-gradient(
			to bottom,
			rgb(245 239 255 / 0.022) 0,
			rgb(245 239 255 / 0.022) 1px,
			rgb(0 0 0 / 0) 2px,
			rgb(0 0 0 / 0) 5px
		);
	}

	.vignette {
		box-shadow:
			inset 0 0 220px rgb(0 0 0 / calc(0.7 - (var(--scroll-progress) * 0.24))),
			inset 0 -120px 180px rgb(16 6 42 / calc(0.5 + (var(--scroll-progress) * 0.2)));
	}

	.scroll-brighten {
		background:
			radial-gradient(
				84rem 50rem at calc(14% + (var(--scroll-progress) * 62%)) 14%,
				rgb(255 104 202 / 0.52),
				transparent 69%
			),
			radial-gradient(
				96rem 68rem at calc(8% + (var(--scroll-progress) * 80%)) 86%,
				rgb(74 244 255 / 0.46),
				transparent 72%
			),
			linear-gradient(
				96deg,
				transparent 0%,
				rgb(255 247 224 / calc(var(--scroll-progress) * 0.2)) 100%
			);
		opacity: calc(0.08 + (var(--scroll-progress) * 0.86));
	}

	.scroll-hint {
		right: 0.5rem;
		top: 50%;
		bottom: auto;
		width: clamp(8.2rem, 10.5vw, 10rem);
		aspect-ratio: 1;
		padding: 0;
		border: none;
		border-radius: 999px;
		display: grid;
		place-items: center;
		background: transparent;
		transform: translate3d(0, -50%, 0);
		box-shadow: none;
		animation: hint-core-bob 3.8s var(--ease-organic) infinite;
	}

	.scroll-hint.is-hidden {
		opacity: 0;
		transform: translate3d(18px, -50%, 0) scale(0.9);
		pointer-events: none;
	}

	.hint-ring {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		animation: hint-ring-spin 9s linear infinite;
		filter: drop-shadow(0 0 16px rgb(166 137 255 / 0.45));
	}

	.hint-ring text {
		fill: rgb(233 222 255 / 0.9);
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 11px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.hint-core {
		width: 48%;
		height: 48%;
		border-radius: 999px;
		display: grid;
		place-items: center;
		gap: 0.16rem;
		background:
			linear-gradient(132deg, rgb(35 16 78 / 0.94), rgb(11 28 66 / 0.9));
		box-shadow:
			0 10px 26px rgb(0 0 0 / 0.44),
			inset 0 0 0 1px rgb(225 213 255 / 0.2),
			inset 0 0 28px rgb(165 142 255 / 0.22);
	}

	.wheel {
		width: 1.02rem;
		height: 1.48rem;
		border-width: 1.4px;
		border-color: rgb(236 228 255 / 0.9);
	}

	.wheel::before {
		background: rgb(236 228 255 / 0.94);
	}

	.arrow {
		font-size: 1.25rem;
		color: rgb(241 234 255 / 0.98);
	}

	.panel {
		position: relative;
		border-radius: 24px;
		background: linear-gradient(152deg, rgb(20 12 44 / 0.44), rgb(8 10 29 / 0.16));
		box-shadow:
			inset 0 0 0 1px rgb(176 147 255 / 0.15),
			0 26px 52px rgb(2 0 10 / 0.44);
	}

	.panel::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background:
			linear-gradient(180deg, rgb(255 255 255 / 0.09), transparent 22%),
			radial-gradient(60% 90% at 85% 6%, rgb(255 82 200 / 0.1), transparent 68%);
		pointer-events: none;
		opacity: 0.86;
	}

	.ghost-frame::before {
		background: conic-gradient(
			from 0deg,
			rgb(74 244 255 / 0.92),
			rgb(255 79 211 / 0.9),
			rgb(219 255 87 / 0.9),
			rgb(169 128 255 / 0.92),
			rgb(74 244 255 / 0.92)
		);
		opacity: 0.12;
		transform: scale(0.998);
		filter: saturate(1.24) blur(0.14px);
	}

	.ghost-frame::after {
		inset: -16px;
		background:
			radial-gradient(58% 68% at 18% 16%, rgb(74 244 255 / 0.34), transparent 78%),
			radial-gradient(54% 66% at 84% 84%, rgb(255 79 211 / 0.36), transparent 80%);
		opacity: 0.36;
		filter: blur(18px);
	}

	.ghost-frame:hover::before,
	.ghost-frame:focus-within::before {
		opacity: 0.96;
	}

	.headline {
		font-family: 'Orbitron', 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(2.35rem, 8.6vw, 6.4rem);
		line-height: 0.86;
		letter-spacing: 0.018em;
		text-transform: uppercase;
	}

	.headline-line {
		column-gap: 0.14em;
	}

	.headline-line + .headline-line {
		margin-top: -0.08em;
	}

	.headline-muted {
		color: rgb(248 243 255 / 0.42);
	}

	.headline-muted.amp {
		color: rgb(248 243 255 / 0.58);
	}

	.glitch-line {
		background: linear-gradient(104deg, #7fffe7 0%, #7fc8ff 20%, #ffe87a 42%, #ff64cf 62%, #9d8bff 82%, #7fffe7 100%);
		background-size: 250% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		text-shadow:
			0 0 18px rgb(127 255 231 / 0.34),
			0 0 28px rgb(157 139 255 / 0.28);
		animation:
			headline-sway 4.1s var(--ease-organic) infinite,
			headline-rainbow 6.6s linear infinite;
	}

	.line-top::before {
		color: #7fffe7;
		opacity: 0.66;
		animation-duration: 3.8s, 2.2s;
	}

	.line-top::after {
		color: #ff64cf;
		opacity: 0.56;
		animation-duration: 4.1s, 2.5s;
	}

	.line-bottom::before {
		color: #ffe87a;
		opacity: 0.62;
		animation-duration: 3.9s, 2.3s;
	}

	.line-bottom::after {
		color: #9d8bff;
		opacity: 0.54;
		animation-duration: 4.3s, 2.6s;
	}

	.hero-logo-void {
		min-height: clamp(9.4rem, 24vh, 17rem);
	}

	.logo-stage::before {
		background:
			conic-gradient(
				from 16deg,
				rgb(74 244 255 / 0.34),
				rgb(255 79 211 / 0.28),
				rgb(255 186 102 / 0.28),
				rgb(169 128 255 / 0.3),
				rgb(74 244 255 / 0.34)
			);
		filter: blur(24px) saturate(1.3);
	}

	.logo-stage::after {
		background:
			repeating-linear-gradient(90deg, rgb(177 146 255 / 0.2) 0 1px, transparent 1px 14px),
			repeating-linear-gradient(0deg, rgb(112 245 255 / 0.2) 0 1px, transparent 1px 10px);
	}

	.logo-face {
		background: linear-gradient(105deg, #7fffe7 0%, #ffe87a 26%, #ff64cf 54%, #9d8bff 78%, #7fffe7 100%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-bottom {
		gap: clamp(1rem, 1.8vw, 1.7rem);
	}

