	.global-signal {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 10;
		overflow: hidden;
		background: rgb(8 13 24 / 0.88);
		backdrop-filter: blur(6px);
	}

	.global-signal-track {
		display: flex;
		width: max-content;
		gap: 0.66rem;
		padding: 0.58rem 0.72rem;
		will-change: transform;
		animation: ticker 27s linear infinite;
	}

	.signal-chip {
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.69rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.28rem 0.54rem;
		border: none;
		border-radius: 999px;
		color: var(--ink-soft);
		background: rgb(255 255 255 / 0.1);
	}

	.reveal {
		opacity: 0;
		transform: translate3d(0, 30px, 0) scale(0.972);
		animation: reveal 1180ms var(--ease-bouncy) forwards;
	}

	.reveal-1 {
		animation-delay: 120ms;
	}

	.reveal-2 {
		animation-delay: 230ms;
	}

	.reveal-3 {
		animation-delay: 360ms;
	}

	@keyframes reveal {
		0% {
			opacity: 0;
			transform: translate3d(0, 30px, 0) scale(0.972);
		}
		68% {
			opacity: 1;
			transform: translate3d(0, -3px, 0) scale(1.012);
		}
		100% {
			opacity: 1;
			transform: translate3d(0, 0, 0) scale(1);
		}
	}

	@keyframes ticker {
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	@keyframes scan-shift {
		0% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(2px);
		}
		100% {
			transform: translateY(4px);
		}
	}

	@keyframes wheel-dot {
		0% {
			opacity: 0;
			transform: translateY(-0.06rem) scale(0.85);
		}
		24% {
			opacity: 1;
		}
		62% {
			opacity: 0.9;
			transform: translateY(0.44rem) scale(1);
		}
		100% {
			opacity: 0;
			transform: translateY(0.74rem) scale(0.9);
		}
	}

	@keyframes arrow-nudge {
		0%,
		100% {
			transform: translateX(0) rotate(0deg);
		}
		36% {
			transform: translateX(4px) rotate(1deg);
		}
		66% {
			transform: translateX(2px) rotate(-0.6deg);
		}
	}

	@keyframes hint-drift {
