	.line-top::after {
		color: var(--violet);
		opacity: 0.5;
		animation:
			chroma-b 4.6s steps(2, end) infinite,
			glitch-cut-b 2.4s steps(2, end) infinite;
	}

	.line-bottom::before {
		color: var(--amber);
		opacity: 0.54;
		animation:
			chroma-c 4.3s steps(2, end) infinite,
			glitch-cut-c 2.2s steps(2, end) infinite;
	}

	.line-bottom::after {
		color: var(--acid);
		opacity: 0.46;
		animation:
			chroma-d 4.9s steps(2, end) infinite,
			glitch-cut-d 2.7s steps(2, end) infinite;
