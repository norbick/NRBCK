---
import Layout from '../layouts/Layout.astro';

type Localized = { pl: string; en: string };

type Project = {
	id: string;
	name: string;
	repo: string;
	theme: string;
	role: Localized;
	blurb: Localized;
	tags: Localized[];
	cta: Localized;
};

const projects: Project[] = [
	{
		id: '01',
		name: 'm2_stage',
		repo: 'https://github.com/norbick/m2_stage',
		theme: 'theme-blue',
		role: { pl: 'Platforma eventowa MVP', en: 'Event platform MVP' },
		blurb: {
			pl: 'Koncept platformy eventowej: szybki przepływ publikacji, czytelny funnel i testy UX na wczesnym etapie.',
			en: 'Event platform concept with fast publishing flow, clear funnel and early-stage UX testing.',
		},
		tags: [
			{ pl: 'Przepływ UX', en: 'UX Flow' },
			{ pl: 'MVP', en: 'MVP' },
			{ pl: 'Kierunek frontendu', en: 'Frontend Direction' },
		],
		cta: { pl: 'Otwórz repozytorium', en: 'Open repository' },
	},
	{
		id: '02',
		name: 'LooLoot',
		repo: 'https://github.com/norbick/LooLoot',
		theme: 'theme-orange',
		role: { pl: 'Koncepcja dropów kolekcjonerskich', en: 'Collectible drop concept' },
		blurb: {
			pl: 'Projekt oparty o mechaniki dropów i kolekcjonowanie przedmiotów, z naciskiem na rytm i mocny feedback.',
			en: 'A concept focused on drop mechanics and collectible loops, built around rhythm and strong feedback.',
		},
		tags: [
			{ pl: 'Logika dropów', en: 'Drop Logic' },
			{ pl: 'Ekonomia gry', en: 'Game Economy' },
			{ pl: 'Wizualizacja produktu', en: 'Product Visuals' },
		],
		cta: { pl: 'Otwórz repozytorium', en: 'Open repository' },
	},
];

const sellingPoints: Localized[] = [
	{
		pl: 'Projektuję pod cel biznesowy: nie tylko ładny widok, ale też decyzje, które zwiększają konwersję.',
		en: 'I design for business outcomes, not just visuals: decisions are made to improve conversion.',
	},
	{
		pl: 'Łączę branding, UX i development, więc koncept nie rozpada się przy wdrożeniu.',
		en: 'I combine branding, UX and development, so the concept stays intact in implementation.',
	},
	{
		pl: 'Błyskawicznie iteruję: szkic, prototyp, test i poprawka w krótkich pętlach.',
		en: 'I iterate fast: sketch, prototype, test and refine in short loops.',
	},
	{
		pl: 'Buduję hierarchię treści tak, żeby użytkownik od razu wiedział co jest ważne.',
		en: 'I structure content hierarchy so users instantly understand what matters.',
	},
	{
		pl: 'Dowożę rzeczy na czas i komunikuję decyzje jasno, bez chaosu projektowego.',
		en: 'I deliver on time and communicate design decisions clearly, without project chaos.',
	},
	{
		pl: 'Lubię odważny kierunek wizualny, ale zawsze kontroluję czytelność i użyteczność.',
		en: 'I like bold visual direction while keeping readability and usability fully under control.',
	},
];

const signals: Localized[] = [
	{ pl: 'PORTFOLIO NRBCK', en: 'NRBCK PORTFOLIO' },
	{ pl: 'FREELANCE DESIGN', en: 'FREELANCE DESIGN' },
	{ pl: 'WEBFLOW + ASTRO', en: 'WEBFLOW + ASTRO' },
	{ pl: 'KIERUNEK WIZUALNY', en: 'VISUAL DIRECTION' },
	{ pl: 'MYŚLENIE PRODUKTOWE', en: 'PRODUCT THINKING' },
	{ pl: 'SZYBKA ITERACJA', en: 'FAST ITERATION LOOP' },
	{ pl: 'MOCNA TYPOGRAFIA', en: 'STRONG TYPOGRAPHY' },
	{ pl: 'JASNA ŚCIEŻKA UŻYTKOWNIKA', en: 'CLEAR USER PATHS' },
	{ pl: 'KREATYWNA INŻYNIERIA', en: 'CREATIVE ENGINEERING' },
	{ pl: 'RUCH Z CELEM', en: 'MOTION WITH PURPOSE' },
	{ pl: 'DESIGN, KTÓRY SPRZEDAJE', en: 'DESIGN THAT CONVERTS' },
	{ pl: 'GOTOWE DO WDROŻENIA', en: 'DEVELOPMENT READY' },
	{ pl: 'LIVE DEPLOY MODE', en: 'LIVE DEPLOY MODE' },
	{ pl: 'NIE GENERYCZNY SZABLON', en: 'NO TEMPLATE VIBES' },
];

const signalTrack = [...signals, ...signals];
---

<Layout title="NRBCK | Portfolio" description="Portfolio NRBCK: design, Webflow i frontend.">
	<main class="shell">
		<script is:inline>
			(() => {
				const langs = navigator.languages?.length ? navigator.languages : [navigator.language || 'en'];
				const isPolish = langs.some((lang) => String(lang).toLowerCase().startsWith('pl'));
				const root = document.documentElement;
				root.classList.add(isPolish ? 'lang-pl' : 'lang-en');
				root.lang = isPolish ? 'pl' : 'en';
			})();
		</script>

		<div class="orb orb-a" aria-hidden="true"></div>
		<div class="orb orb-b" aria-hidden="true"></div>
		<div class="scanlines" aria-hidden="true"></div>
		<div class="vignette" aria-hidden="true"></div>

		<div class="scroll-hint" id="scroll-hint" aria-hidden="true">
			<span class="wheel"></span>
			<span class="arrow">→</span>
		</div>

		<section class="rail" id="horizontal-rail">
			<article class="panel panel-hero reveal reveal-1">
				<h1 class="headline">
					<span class="headline-line">
						<span class="headline-muted t-inline">
							<span data-l10n="pl">FREELANCE</span>
							<span data-l10n="en">FREELANCE</span>
						</span>
						<span class="glitch-line line-top" data-l10n="pl" data-text="DESIGNER WWW">DESIGNER WWW</span>
						<span class="glitch-line line-top" data-l10n="en" data-text="WEB DESIGNER">WEB DESIGNER</span>
					</span>
					<span class="headline-line">
						<span class="headline-muted amp">&amp;</span>
						<span class="glitch-line line-bottom" data-l10n="pl" data-text="DEWELOPER WEBFLOW">DEWELOPER WEBFLOW</span>
						<span class="glitch-line line-bottom" data-l10n="en" data-text="WEBFLOW DEVELOPER">WEBFLOW DEVELOPER</span>
					</span>
				</h1>

				<div class="hero-bottom">
					<p class="t-block hero-copy">
						<span data-l10n="pl">
							Projektuję i koduję strony, które mają charakter, prowadzą użytkownika jasno i pomagają realnie
							sprzedawać ofertę.
						</span>
						<span data-l10n="en">
							I design and build websites with character, clear user guidance and strong business impact.
						</span>
					</p>
					<p class="t-block hero-copy">
						<span data-l10n="pl">
							Skupiam się na czytelności, odważnej typografii i precyzyjnym flow od pierwszego ekranu do akcji.
						</span>
						<span data-l10n="en">
							My focus is readability, bold typography and precise flow from first impression to action.
						</span>
					</p>
				</div>
			</article>

			<article id="projects" class="panel panel-projects reveal reveal-2">
				<div class="project-grid">
					{projects.map((project) => (
						<article class={`project-frame ${project.theme}`}>
							<p class="project-id">{project.id}</p>
							<p class="project-role t-inline">
								<span data-l10n="pl">{project.role.pl}</span>
								<span data-l10n="en">{project.role.en}</span>
							</p>
							<h2 class="project-title">{project.name}</h2>
							<p class="project-copy t-block">
								<span data-l10n="pl">{project.blurb.pl}</span>
								<span data-l10n="en">{project.blurb.en}</span>
							</p>
							<ul class="project-tags">
								{project.tags.map((tag) => (
									<li class="project-tag t-inline">
										<span data-l10n="pl">{tag.pl}</span>
										<span data-l10n="en">{tag.en}</span>
									</li>
								))}
							</ul>
							<a class="project-link t-inline" href={project.repo} target="_blank" rel="noreferrer">
								<span data-l10n="pl">{project.cta.pl}</span>
								<span data-l10n="en">{project.cta.en}</span>
							</a>
						</article>
					))}
				</div>
			</article>

			<article class="panel panel-value reveal reveal-3">
				<div class="value-shell">
					<div class="value-intro">
						<p class="value-kicker t-inline">
							<span data-l10n="pl">Dlaczego warto ze mną pracować</span>
							<span data-l10n="en">Why work with me</span>
						</p>
						<h3 class="value-title t-block">
							<span data-l10n="pl">Design i development spięte w jedną, skuteczną całość</span>
							<span data-l10n="en">Design and development fused into one effective process</span>
						</h3>
						<p class="value-copy t-block">
							<span data-l10n="pl">
								Każdy element wizualny ma tu robić robotę: budować zaufanie, prowadzić uwagę i skracać drogę do
								działania.
							</span>
							<span data-l10n="en">
								Every visual element is here to do a job: build trust, guide attention and shorten the path to action.
							</span>
						</p>
					</div>

					<div class="selling-grid">
						{sellingPoints.map((point) => (
							<article class="selling-card">
								<p class="selling-copy t-block">
									<span data-l10n="pl">{point.pl}</span>
									<span data-l10n="en">{point.en}</span>
								</p>
							</article>
						))}
					</div>
				</div>
			</article>
		</section>

		<aside class="global-signal" aria-label="Signal rail">
			<div class="global-signal-track" aria-hidden="true">
				{signalTrack.map((item) => (
					<span class="signal-chip t-inline">
						<span data-l10n="pl">{item.pl}</span>
						<span data-l10n="en">{item.en}</span>
					</span>
				))}
			</div>
		</aside>
	</main>

	<script is:inline>
		const rail = document.getElementById('horizontal-rail');
		const hint = document.getElementById('scroll-hint');
		const desktop = window.matchMedia('(min-width: 921px)');

		if (rail) {
			const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
			let target = rail.scrollLeft;
			let current = rail.scrollLeft;
			let raf = 0;

			const syncState = () => {
				target = rail.scrollLeft;
				current = rail.scrollLeft;
			};

			const updateHint = () => {
				if (!hint) return;
				if (!desktop.matches || rail.scrollLeft > 60) hint.classList.add('is-hidden');
				else hint.classList.remove('is-hidden');
			};

			const animate = () => {
				const diff = target - current;
				current += diff * 0.16;
				rail.scrollLeft = current;
				updateHint();
				if (Math.abs(diff) > 0.3) raf = requestAnimationFrame(animate);
				else {
					syncState();
					raf = 0;
				}
			};

			const moveBy = (delta) => {
				if (!raf) syncState();
				target = clamp(target + delta, 0, rail.scrollWidth - rail.clientWidth);
				if (!raf) raf = requestAnimationFrame(animate);
			};

			const onWheel = (event) => {
				if (!desktop.matches) return;
				const source = Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX;
				if (source === 0) return;
				event.preventDefault();
				const normalized = Math.sign(source) * Math.min(Math.abs(source), 95);
				moveBy(normalized * 2.2);
			};

			const onKey = (event) => {
				if (!desktop.matches) return;
				if (event.key === 'ArrowDown' || event.key === 'PageDown') {
					event.preventDefault();
					moveBy(window.innerWidth * 0.86);
				}
				if (event.key === 'ArrowUp' || event.key === 'PageUp') {
					event.preventDefault();
					moveBy(-window.innerWidth * 0.86);
				}
			};

			const onDesktopChange = () => {
				if (!desktop.matches) {
					if (raf) {
						cancelAnimationFrame(raf);
						raf = 0;
					}
					rail.scrollLeft = 0;
					target = 0;
					current = 0;
				}
				updateHint();
			};

			const onRailScroll = () => {
				updateHint();
				if (!raf) syncState();
			};

			window.addEventListener('wheel', onWheel, { passive: false });
			window.addEventListener('keydown', onKey);
			rail.addEventListener('scroll', onRailScroll, { passive: true });
			desktop.addEventListener('change', onDesktopChange);
			updateHint();
		}

		document.querySelectorAll('.selling-card').forEach((card) => {
			const element = /** @type {HTMLElement} */ (card);
			element.addEventListener('pointermove', (event) => {
				const e = /** @type {PointerEvent} */ (event);
				const rect = element.getBoundingClientRect();
				const x = (e.clientX - rect.left) / rect.width - 0.5;
				const y = (e.clientY - rect.top) / rect.height - 0.5;
				element.style.setProperty('--rx', `${(-y * 14).toFixed(2)}deg`);
				element.style.setProperty('--ry', `${(x * 16).toFixed(2)}deg`);
			});

			element.addEventListener('pointerleave', () => {
				element.style.setProperty('--rx', '0deg');
				element.style.setProperty('--ry', '0deg');
			});
		});
	</script>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@500;600&family=Sora:wght@400;600;700&display=swap');

	:root {
		--bg-0: #070b15;
		--bg-1: #0d1426;
		--bg-2: #121c34;
		--ink: #f1f4ff;
		--ink-soft: #adb8d8;
		--line: rgb(143 166 224 / 0.34);
		--cyan: #49a9ff;
		--pink: #ff8450;
		--acid: #b2ff4f;
		--amber: #ffd066;
	}

	:global(body) {
		font-family: 'Sora', 'Trebuchet MS', sans-serif;
		color: var(--ink);
		background:
			radial-gradient(44rem 34rem at 12% 10%, rgb(255 132 80 / 0.14), transparent 72%),
			radial-gradient(40rem 30rem at 88% 18%, rgb(73 169 255 / 0.16), transparent 74%),
			linear-gradient(132deg, var(--bg-0) 0%, var(--bg-1) 52%, var(--bg-2) 100%);
	}

	@media (min-width: 921px) {
		:global(body) {
			overflow: hidden;
		}
	}

	[data-l10n] {
		display: none;
	}

	.t-inline > [data-l10n='en'] {
		display: inline;
	}

	.t-block > [data-l10n='en'] {
		display: block;
	}

	html.lang-pl .t-inline > [data-l10n='pl'] {
		display: inline;
	}

	html.lang-pl .t-inline > [data-l10n='en'] {
		display: none;
	}

	html.lang-pl .t-block > [data-l10n='pl'] {
		display: block;
	}

	html.lang-pl .t-block > [data-l10n='en'] {
		display: none;
	}

	.glitch-line[data-l10n] {
		display: none;
	}

	html.lang-en .glitch-line[data-l10n='en'],
	html.lang-pl .glitch-line[data-l10n='pl'],
	html:not(.lang-pl):not(.lang-en) .glitch-line[data-l10n='en'] {
		display: inline-block;
	}

	.shell {
		position: relative;
		min-height: 100vh;
	}

	.orb {
		position: fixed;
		width: min(46vw, 620px);
		height: min(46vw, 620px);
		border-radius: 50%;
		filter: blur(64px);
		pointer-events: none;
		z-index: 0;
		opacity: 0.35;
	}

	.orb-a {
		top: -18vh;
		left: -10vw;
		background: radial-gradient(circle, rgb(255 132 80 / 0.8), rgb(255 132 80 / 0));
		animation: orb-drift-a 16s ease-in-out infinite;
	}

	.orb-b {
		right: -12vw;
		bottom: -22vh;
		background: radial-gradient(circle, rgb(73 169 255 / 0.82), rgb(73 169 255 / 0));
		animation: orb-drift-b 18s ease-in-out infinite;
	}

	.scanlines {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 2;
		background: repeating-linear-gradient(
			to bottom,
			rgb(241 244 255 / 0.018) 0,
			rgb(241 244 255 / 0.018) 1px,
			rgb(0 0 0 / 0) 2px,
			rgb(0 0 0 / 0) 4px
		);
		animation: scan-shift 12s linear infinite;
	}

	.vignette {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 1;
		box-shadow: inset 0 0 180px rgb(0 0 0 / 0.55);
	}

	.scroll-hint {
		position: fixed;
		right: 1rem;
		bottom: 3.4rem;
		z-index: 9;
		display: inline-flex;
		align-items: center;
		gap: 0.48rem;
		padding: 0.5rem 0.72rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgb(8 13 25 / 0.8);
		backdrop-filter: blur(4px);
		transition: opacity 260ms ease, transform 260ms ease;
	}

	.scroll-hint.is-hidden {
		opacity: 0;
		transform: translateY(14px);
		pointer-events: none;
	}

	.wheel {
		display: inline-block;
		width: 0.86rem;
		height: 1.26rem;
		border-radius: 999px;
		border: 1px solid var(--ink-soft);
		position: relative;
	}

	.wheel::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0.2rem;
		width: 0.18rem;
		height: 0.22rem;
		margin-left: -0.09rem;
		border-radius: 999px;
		background: var(--ink-soft);
		animation: wheel-dot 1.7s ease infinite;
	}

	.arrow {
		font-size: 1rem;
		color: var(--ink-soft);
		animation: arrow-nudge 1.8s ease infinite;
	}

	.rail {
		position: relative;
		z-index: 4;
		display: flex;
		height: 100vh;
		overflow-x: auto;
		overflow-y: hidden;
		gap: 1.2rem;
		padding: 1rem 1rem 4.2rem;
		scrollbar-width: none;
	}

	.rail::-webkit-scrollbar {
		display: none;
	}

	.panel {
		flex: 0 0 calc(100vw - 2rem);
		height: calc(100vh - 5.2rem);
		padding: clamp(0.9rem, 2vw, 1.6rem);
		overflow: visible;
	}

	.panel-hero {
		display: grid;
		grid-template-rows: 1fr auto;
		align-content: center;
	}

	.headline {
		margin: 0;
		font-family: 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(2.6rem, 10vw, 7.4rem);
		line-height: 0.84;
		letter-spacing: 0.008em;
		display: grid;
		gap: 0.02em;
	}

	.headline-line {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: 0.18em;
	}

	.headline-muted {
		color: rgb(241 244 255 / 0.38);
	}

	.headline-muted.amp {
		color: rgb(241 244 255 / 0.54);
	}

	.glitch-line {
		position: relative;
		color: var(--ink);
		will-change: transform;
		animation: headline-sway 5.2s cubic-bezier(0.33, 0, 0.67, 1) infinite;
	}

	.glitch-line::before,
	.glitch-line::after {
		content: attr(data-text);
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0.9;
		will-change: transform, clip-path;
	}

	.line-top::before {
		color: var(--cyan);
		animation:
			glitch-shift-a 3.2s linear infinite,
			glitch-cut-a 1.6s steps(1, end) infinite;
	}

	.line-top::after {
		color: var(--pink);
		animation:
			glitch-shift-b 2.9s linear infinite,
			glitch-cut-b 1.9s steps(1, end) infinite;
	}

	.line-bottom::before {
		color: var(--amber);
		animation:
			glitch-shift-c 3.5s linear infinite,
			glitch-cut-c 1.8s steps(1, end) infinite;
	}

	.line-bottom::after {
		color: var(--acid);
		animation:
			glitch-shift-d 2.7s linear infinite,
			glitch-cut-d 2.1s steps(1, end) infinite;
	}

	.hero-bottom {
		margin-top: 1.1rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.2rem;
		align-items: end;
	}

	.hero-copy {
		margin: 0;
		font-size: 1rem;
		line-height: 1.58;
		color: var(--ink-soft);
		max-width: 62ch;
	}

	.panel-projects {
		display: flex;
		align-items: center;
	}

	.project-grid {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.95rem;
	}

	.project-frame {
		padding: 1.14rem;
		border-radius: 20px;
		border: 1px solid var(--line);
		background: rgb(11 18 34 / 0.74);
		backdrop-filter: blur(4px);
		box-shadow: 0 18px 32px rgb(0 0 0 / 0.34);
		display: grid;
		gap: 0.72rem;
		transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
	}

	.project-frame:hover {
		transform: translateY(-6px);
		box-shadow: 0 24px 38px rgb(0 0 0 / 0.42);
	}

	.project-id {
		margin: 0;
		font-family: 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(1.7rem, 3.8vw, 2.6rem);
		line-height: 1;
		color: rgb(241 244 255 / 0.22);
	}

	.project-role {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.project-title {
		margin: 0;
		font-size: clamp(1.55rem, 3vw, 2.2rem);
		line-height: 0.95;
	}

	.project-copy {
		margin: 0;
		line-height: 1.56;
