---
import Layout from '../layouts/Layout.astro';

type Localized = { pl: string; en: string };

type Project = {
	id: string;
	name: string;
	repo: string;
	theme: string;
	role: Localized;
	blurb: Localized;
	tags: Localized[];
	cta: Localized;
};

const projects: Project[] = [
	{
		id: '01',
		name: 'm2_stage',
		repo: 'https://github.com/norbick/m2_stage',
		theme: 'theme-blue',
		role: { pl: 'Strona dla projektu eventowego', en: 'Website for an event project' },
		blurb: {
			pl: 'Miejsce, w którym organizator pokazuje wydarzenie, a użytkownik od razu wie co, kiedy i jak dołączyć.',
			en: 'A place where the organizer presents the event and the user instantly sees what, when and how to join.',
		},
		tags: [
			{ pl: 'Czytelny układ', en: 'Clear layout' },
			{ pl: 'MVP', en: 'MVP' },
			{ pl: 'Szybkie wdrożenie', en: 'Fast launch' },
		],
		cta: { pl: 'Zobacz repozytorium', en: 'View repository' },
	},
	{
		id: '02',
		name: 'LooLoot',
		repo: 'https://github.com/norbick/LooLoot',
		theme: 'theme-orange',
		role: { pl: 'Projekt strony pod produkt cyfrowy', en: 'Website concept for a digital product' },
		blurb: {
			pl: 'Mocny, charakterystyczny styl z naciskiem na emocje, zrozumiały flow i szybkie przejście do działania.',
			en: 'A bold visual style focused on emotion, understandable flow and a fast path to action.',
		},
		tags: [
			{ pl: 'Wyrazisty styl', en: 'Bold style' },
			{ pl: 'Płynna nawigacja', en: 'Smooth navigation' },
			{ pl: 'Lepsza konwersja', en: 'Better conversion' },
		],
		cta: { pl: 'Zobacz repozytorium', en: 'View repository' },
	},
];

const sellingPoints: Localized[] = [
	{
		pl: 'Mówisz, czego potrzebujesz, a ja przekładam to na stronę, którą łatwo zrozumieć.',
		en: 'You tell me what you need, and I turn it into a website people instantly understand.',
	},
	{
		pl: 'Jedna osoba od całości: design, Webflow i wdrożenie bez przepychanek.',
		en: 'One person for the whole flow: design, Webflow, and launch without handoff chaos.',
	},
	{
		pl: 'Nie znikam na tydzień. Regularnie pokazuję postęp i konkretne decyzje.',
		en: 'I do not disappear for a week. You get regular progress and clear decisions.',
	},
	{
		pl: 'Układ i treść prowadzą odwiedzającego prosto do kontaktu, bez błądzenia.',
		en: 'Layout and copy guide visitors straight to contact, without confusion.',
	},
	{
		pl: 'Każdy projekt ma własny charakter, zero generycznych gotowców.',
		en: 'Every project gets its own character, never a generic template look.',
	},
	{
		pl: 'Mówię prosto: co robimy teraz, co dalej i po co to jest.',
		en: 'I keep it simple: what we do now, what comes next, and why it matters.',
	},
];

const signals: Localized[] = [
	{ pl: 'NRBCK PORTFOLIO', en: 'NRBCK PORTFOLIO' },
	{ pl: 'FREELANCE WEB DESIGN', en: 'FREELANCE WEB DESIGN' },
	{ pl: 'WEBFLOW + ASTRO', en: 'WEBFLOW + ASTRO' },
	{ pl: 'FROM IDEA TO LAUNCH', en: 'FROM IDEA TO LAUNCH' },
	{ pl: 'CLEAR MESSAGING', en: 'CLEAR MESSAGING' },
	{ pl: 'CLEAR FLOW', en: 'CLEAR FLOW' },
	{ pl: 'STRONG TYPOGRAPHY', en: 'STRONG TYPOGRAPHY' },
	{ pl: 'FAST ITERATION', en: 'FAST ITERATION' },
	{ pl: 'DESIGN THAT CONVERTS', en: 'DESIGN THAT CONVERTS' },
	{ pl: 'NO STIFF JARGON', en: 'NO STIFF JARGON' },
	{ pl: 'CONTACT AND DELIVERY', en: 'CONTACT AND DELIVERY' },
	{ pl: 'DEVELOPMENT READY', en: 'DEVELOPMENT READY' },
	{ pl: 'LIVE DEPLOY MODE', en: 'LIVE DEPLOY MODE' },
	{ pl: 'UI + WEBFLOW SYSTEMS', en: 'UI + WEBFLOW SYSTEMS' },
];

const signalTrack = [...signals, ...signals];
---

<Layout title="NRBCK | Portfolio" description="Portfolio NRBCK: design, Webflow i frontend.">
	<main class="shell">
		<script is:inline>
			(() => {
				const langs = navigator.languages?.length ? navigator.languages : [navigator.language || 'en'];
				const isPolish = langs.some((lang) => String(lang).toLowerCase().startsWith('pl'));
				const root = document.documentElement;
				root.classList.add(isPolish ? 'lang-pl' : 'lang-en');
				root.lang = isPolish ? 'pl' : 'en';
			})();
		</script>

		<div class="orb orb-a" aria-hidden="true"></div>
		<div class="orb orb-b" aria-hidden="true"></div>
		<div class="scroll-brighten" aria-hidden="true"></div>
		<div class="scanlines" aria-hidden="true"></div>
		<div class="vignette" aria-hidden="true"></div>

		<div class="scroll-hint" id="scroll-hint" aria-hidden="true">
			<span class="wheel"></span>
			<span class="arrow">→</span>
		</div>

		<section class="rail" id="horizontal-rail">
			<article class="panel panel-hero reveal reveal-1">
				<h1 class="headline">
					<span class="headline-line">
						<span class="headline-muted t-inline">
							<span data-l10n="pl">FREELANCE</span>
							<span data-l10n="en">FREELANCE</span>
						</span>
						<span class="glitch-line line-top" data-l10n="pl" data-text="WEB DESIGNER">WEB DESIGNER</span>
						<span class="glitch-line line-top" data-l10n="en" data-text="WEB DESIGNER">WEB DESIGNER</span>
					</span>
					<span class="headline-line">
						<span class="headline-muted amp">&amp;</span>
						<span class="glitch-line line-bottom" data-l10n="pl" data-text="WEBFLOW DEVELOPER">WEBFLOW DEVELOPER</span>
						<span class="glitch-line line-bottom" data-l10n="en" data-text="WEBFLOW DEVELOPER">WEBFLOW DEVELOPER</span>
					</span>
				</h1>

				<div class="hero-bottom">
					<p class="t-block hero-copy">
						<span data-l10n="pl">
							Twoja strona ma robić robotę od pierwszego wejścia: pokazać ofertę, zbudować zaufanie i domknąć kontakt.
						</span>
						<span data-l10n="en">
							Your website should deliver from the first second: explain the offer, build trust, and drive contact.
						</span>
					</p>
					<p class="t-block hero-copy">
						<span data-l10n="pl">
							Biorę to na siebie od A do Z: koncept, design, Webflow i publikacja. Ty dostajesz efekt, nie chaos.
						</span>
						<span data-l10n="en">
							I handle it end to end: concept, design, Webflow, and launch. You get results, not production chaos.
						</span>
					</p>
				</div>
			</article>

			<article id="projects" class="panel panel-projects reveal reveal-2">
				<div class="project-grid">
					{projects.map((project) => (
						<article class={`project-frame ghost-frame ${project.theme}`}>
							<p class="project-id">{project.id}</p>
							<p class="project-role t-inline">
								<span data-l10n="pl">{project.role.pl}</span>
								<span data-l10n="en">{project.role.en}</span>
							</p>
							<h2 class="project-title">{project.name}</h2>
							<p class="project-copy t-block">
								<span data-l10n="pl">{project.blurb.pl}</span>
								<span data-l10n="en">{project.blurb.en}</span>
							</p>
							<ul class="project-tags">
								{project.tags.map((tag) => (
									<li class="project-tag t-inline">
										<span data-l10n="pl">{tag.pl}</span>
										<span data-l10n="en">{tag.en}</span>
									</li>
								))}
							</ul>
							<a class="project-link t-inline" href={project.repo} target="_blank" rel="noreferrer">
								<span data-l10n="pl">{project.cta.pl}</span>
								<span data-l10n="en">{project.cta.en}</span>
							</a>
						</article>
					))}
				</div>
			</article>

			<article class="panel panel-value reveal reveal-3">
				<div class="value-shell">
					<div class="value-intro ghost-frame">
						<p class="value-kicker t-inline">
							<span data-l10n="pl">Dlaczego warto</span>
							<span data-l10n="en">Why me</span>
						</p>
						<h3 class="value-title t-block">
							<span data-l10n="pl">Jedna osoba. Jeden kierunek. Konkretny efekt.</span>
							<span data-l10n="en">One person. One direction. Real results.</span>
						</h3>
						<p class="value-copy t-block">
							<span data-l10n="pl">
								Nie sprzedaję Ci korpo-slajdów. Projektuję stronę, która mówi językiem Twojego klienta i prowadzi go do zapytania.
							</span>
							<span data-l10n="en">
								No buzzword decks. I build websites that speak your client's language and lead them to inquiry.
							</span>
						</p>
					</div>

					<div class="selling-grid">
						{sellingPoints.map((point) => (
							<article class="selling-card ghost-frame">
								<p class="selling-copy t-block">
									<span data-l10n="pl">{point.pl}</span>
									<span data-l10n="en">{point.en}</span>
								</p>
							</article>
						))}
					</div>
				</div>
			</article>

			<article class="panel panel-contact reveal reveal-4">
				<div class="contact-shell">
					<div class="contact-intro ghost-frame">
						<p class="contact-kicker t-inline">
							<span data-l10n="pl">Kontakt</span>
							<span data-l10n="en">Contact</span>
						</p>
						<h3 class="contact-title t-block">
							<span data-l10n="pl">Masz pomysł na stronę? Napisz, czego potrzebujesz.</span>
							<span data-l10n="en">Have a website idea? Tell me what you need.</span>
						</h3>
						<p class="contact-copy t-block">
							<span data-l10n="pl">To wersja testowa: formularz otworzy maila z gotową treścią.</span>
							<span data-l10n="en">This is a demo version: the form opens your email app with a prefilled message.</span>
						</p>
					</div>

					<form class="contact-form ghost-frame" id="contact-form" novalidate>
						<label class="field">
							<span class="field-label t-inline">
								<span data-l10n="pl">Imię</span>
								<span data-l10n="en">Name</span>
							</span>
							<input type="text" name="name" required data-ph-pl="Jak masz na imię?" data-ph-en="What's your name?" />
						</label>

						<label class="field">
							<span class="field-label t-inline">
								<span data-l10n="pl">E-mail</span>
								<span data-l10n="en">Email</span>
							</span>
							<input type="email" name="email" required data-ph-pl="Na jaki adres mam odpisać?" data-ph-en="Where should I reply?" />
						</label>

						<label class="field">
							<span class="field-label t-inline">
								<span data-l10n="pl">Co ma robić Twoja strona?</span>
								<span data-l10n="en">What should your website do?</span>
							</span>
							<textarea name="message" rows="4" required data-ph-pl="Np. chcę więcej zapytań od klientów" data-ph-en="For example: I want more leads from my website"></textarea>
						</label>

						<label class="field">
							<span class="field-label t-inline">
								<span data-l10n="pl">Kiedy chcesz ruszyć?</span>
								<span data-l10n="en">When do you want to start?</span>
							</span>
							<select name="timeline" required>
								<option value="" selected disabled data-label-pl="Wybierz termin" data-label-en="Select timeline">Select timeline</option>
								<option value="asap" data-label-pl="Jak najszybciej" data-label-en="ASAP">ASAP</option>
								<option value="this-month" data-label-pl="W tym miesiącu" data-label-en="This month">This month</option>
								<option value="next-month" data-label-pl="W przyszłym miesiącu" data-label-en="Next month">Next month</option>
							</select>
						</label>

						<button class="contact-submit t-inline" type="submit">
							<span data-l10n="pl">Wyślij zapytanie</span>
							<span data-l10n="en">Send inquiry</span>
						</button>

						<p class="contact-status" id="contact-status" aria-live="polite"></p>
					</form>
				</div>
			</article>
		</section>

		<aside class="global-signal" aria-label="Signal rail">
			<div class="global-signal-track" aria-hidden="true">
				{signalTrack.map((item) => (
					<span class="signal-chip t-inline">
						<span data-l10n="pl">{item.pl}</span>
						<span data-l10n="en">{item.en}</span>
					</span>
				))}
			</div>
		</aside>
	</main>

		<script is:inline>
		const root = document.documentElement;
		const isPolish = root.classList.contains('lang-pl');

		document.querySelectorAll('[data-ph-pl]').forEach((node) => {
			const element = /** @type {HTMLElement} */ (node);
			const phPl = element.getAttribute('data-ph-pl') || '';
			const phEn = element.getAttribute('data-ph-en') || phPl;
			element.setAttribute('placeholder', isPolish ? phPl : phEn);
		});

		document.querySelectorAll('option[data-label-pl]').forEach((node) => {
			const option = /** @type {HTMLOptionElement} */ (node);
			const labelPl = option.getAttribute('data-label-pl') || option.textContent || '';
			const labelEn = option.getAttribute('data-label-en') || labelPl;
			option.textContent = isPolish ? labelPl : labelEn;
		});

		const rail = document.getElementById('horizontal-rail');
		const hint = document.getElementById('scroll-hint');
		const brighten = document.querySelector('.scroll-brighten');
		const desktop = window.matchMedia('(min-width: 921px)');

		if (rail) {
			const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
			let target = rail.scrollLeft;
			let current = rail.scrollLeft;
			let raf = 0;

			const updateProgress = () => {
				const max = rail.scrollWidth - rail.clientWidth;
				const progress = max > 0 ? rail.scrollLeft / max : 0;
				const eased = Math.pow(progress, 0.82);
				root.style.setProperty('--scroll-progress', eased.toFixed(4));
				if (brighten instanceof HTMLElement) {
					brighten.style.opacity = String(0.04 + eased * 0.92);
					brighten.style.transform = `translate3d(${(eased * 6).toFixed(2)}vw, 0, 0)`;
				}
			};

			const syncState = () => {
				target = rail.scrollLeft;
				current = rail.scrollLeft;
			};

			const updateHint = () => {
				if (!hint) return;
				if (!desktop.matches || rail.scrollLeft > 60) hint.classList.add('is-hidden');
				else hint.classList.remove('is-hidden');
			};

			const animate = () => {
				const diff = target - current;
				current += diff * 0.16;
				rail.scrollLeft = current;
				updateHint();
				updateProgress();
				if (Math.abs(diff) > 0.3) raf = requestAnimationFrame(animate);
				else {
					syncState();
					updateProgress();
					raf = 0;
				}
			};

			const moveBy = (delta) => {
				if (!raf) syncState();
				target = clamp(target + delta, 0, rail.scrollWidth - rail.clientWidth);
				if (!raf) raf = requestAnimationFrame(animate);
			};

			const onWheel = (event) => {
				if (!desktop.matches) return;
				const source = Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX;
				if (source === 0) return;
				event.preventDefault();
				const normalized = Math.sign(source) * Math.min(Math.abs(source), 95);
				moveBy(normalized * 2.2);
			};

			const onKey = (event) => {
				if (!desktop.matches) return;
				if (event.key === 'ArrowDown' || event.key === 'PageDown') {
					event.preventDefault();
					moveBy(window.innerWidth * 0.86);
				}
				if (event.key === 'ArrowUp' || event.key === 'PageUp') {
					event.preventDefault();
					moveBy(-window.innerWidth * 0.86);
				}
			};

			const onDesktopChange = () => {
				if (!desktop.matches) {
					if (raf) {
						cancelAnimationFrame(raf);
						raf = 0;
					}
					rail.scrollLeft = 0;
					target = 0;
					current = 0;
					root.style.setProperty('--scroll-progress', '0');
					if (brighten instanceof HTMLElement) {
						brighten.style.opacity = '0.04';
						brighten.style.transform = 'translate3d(0, 0, 0)';
					}
				}
				updateHint();
				updateProgress();
			};

			const onRailScroll = () => {
				updateHint();
				updateProgress();
				if (!raf) syncState();
			};

			window.addEventListener('wheel', onWheel, { passive: false });
			window.addEventListener('keydown', onKey);
			rail.addEventListener('scroll', onRailScroll, { passive: true });
			desktop.addEventListener('change', onDesktopChange);
			updateHint();
			updateProgress();
		}

		document.querySelectorAll('.selling-card').forEach((card) => {
			const element = /** @type {HTMLElement} */ (card);
			element.addEventListener('pointermove', (event) => {
				const e = /** @type {PointerEvent} */ (event);
				const rect = element.getBoundingClientRect();
				const x = (e.clientX - rect.left) / rect.width - 0.5;
				const y = (e.clientY - rect.top) / rect.height - 0.5;
				element.style.setProperty('--rx', `${(-y * 7.5).toFixed(2)}deg`);
				element.style.setProperty('--ry', `${(x * 8.5).toFixed(2)}deg`);
			});

			element.addEventListener('pointerleave', () => {
				element.style.setProperty('--rx', '0deg');
				element.style.setProperty('--ry', '0deg');
			});
		});

		const contactForm = document.getElementById('contact-form');
		const contactStatus = document.getElementById('contact-status');

		if (contactForm && contactStatus) {
			contactForm.addEventListener('submit', (event) => {
				event.preventDefault();
				const formData = new FormData(/** @type {HTMLFormElement} */ (contactForm));
				const name = String(formData.get('name') || '');
				const email = String(formData.get('email') || '');
				const message = String(formData.get('message') || '');
				const timeline = String(formData.get('timeline') || '');

				if (!name || !email || !message || !timeline) {
					contactStatus.textContent = isPolish
						? 'Uzupełnij proszę wszystkie pola.'
						: 'Please fill in all fields.';
					return;
				}

				const subject = isPolish ? `Nowe zapytanie od ${name}` : `New inquiry from ${name}`;
				const body = isPolish
					? `Imię: ${name}\nE-mail: ${email}\nTermin: ${timeline}\n\nOpis projektu:\n${message}`
					: `Name: ${name}\nEmail: ${email}\nTimeline: ${timeline}\n\nProject details:\n${message}`;

				const mailto = `mailto:norbick@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
				window.location.href = mailto;
				contactStatus.textContent = isPolish
					? 'Super, otwieram Twoją aplikację mailową.'
					: 'Great, opening your email app now.';
			});
		}
	</script>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@500;600&family=Sora:wght@400;600;700&display=swap');

	:root {
		--bg-0: #03050d;
		--bg-1: #060b18;
		--bg-2: #0d152a;
		--ink: #f1f4ff;
		--ink-soft: #a9b4d4;
		--line: rgb(143 166 224 / 0.26);
		--cyan: #4ab8ff;
		--pink: #ff7b56;
		--acid: #b4ff5c;
		--amber: #ffd36d;
		--scroll-progress: 0;
		--ease-organic: cubic-bezier(0.22, 0.86, 0.28, 1);
		--ease-bouncy: cubic-bezier(0.2, 1.02, 0.3, 1);
		--dur-xs: 220ms;
		--dur-sm: 360ms;
		--dur-md: 620ms;
		--dur-lg: 1200ms;
	}

	:global(body) {
		font-family: 'Sora', 'Trebuchet MS', sans-serif;
		color: var(--ink);
		background:
			radial-gradient(44rem 34rem at 12% 10%, rgb(255 132 80 / 0.13), transparent 72%),
			radial-gradient(42rem 32rem at 88% 18%, rgb(73 169 255 / 0.15), transparent 74%),
			linear-gradient(132deg, var(--bg-0) 0%, var(--bg-1) 52%, var(--bg-2) 100%);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	@media (min-width: 921px) {
		:global(body) {
			overflow: hidden;
		}
	}

	[data-l10n] {
		display: none;
	}

	.t-inline > [data-l10n='en'] {
		display: inline;
	}

	.t-block > [data-l10n='en'] {
		display: block;
	}

	html.lang-pl .t-inline > [data-l10n='pl'] {
		display: inline;
	}

	html.lang-pl .t-inline > [data-l10n='en'] {
		display: none;
	}

	html.lang-pl .t-block > [data-l10n='pl'] {
		display: block;
	}

	html.lang-pl .t-block > [data-l10n='en'] {
		display: none;
	}

	.glitch-line[data-l10n] {
		display: none;
	}

	html.lang-en .glitch-line[data-l10n='en'],
	html.lang-pl .glitch-line[data-l10n='pl'],
	html:not(.lang-pl):not(.lang-en) .glitch-line[data-l10n='en'] {
		display: inline-block;
	}

	.shell {
		position: relative;
		min-height: 100vh;
	}

	.orb {
		position: fixed;
		width: min(46vw, 620px);
		height: min(46vw, 620px);
		border-radius: 50%;
		filter: blur(64px);
		pointer-events: none;
		z-index: 0;
		opacity: 0.24;
	}

	.orb-a {
		top: -18vh;
		left: -10vw;
		background: radial-gradient(circle, rgb(255 132 80 / 0.8), rgb(255 132 80 / 0));
		animation: orb-drift-a 21s var(--ease-organic) infinite alternate;
	}

	.orb-b {
		right: -12vw;
		bottom: -22vh;
		background: radial-gradient(circle, rgb(73 169 255 / 0.82), rgb(73 169 255 / 0));
		animation: orb-drift-b 24s var(--ease-organic) infinite alternate-reverse;
	}

	.scroll-brighten {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 3;
		background:
			radial-gradient(
				80rem 52rem at calc(16% + (var(--scroll-progress) * 64%)) 14%,
				rgb(255 180 116 / 0.62),
				transparent 67%
			),
			radial-gradient(
				90rem 66rem at calc(8% + (var(--scroll-progress) * 78%)) 86%,
				rgb(118 179 255 / 0.56),
				transparent 72%
			),
			linear-gradient(
				100deg,
				transparent 0%,
				rgb(245 250 255 / calc(var(--scroll-progress) * 0.26)) 100%
			);
		opacity: calc(0.04 + (var(--scroll-progress) * 0.92));
		transition: opacity var(--dur-sm) var(--ease-organic), transform var(--dur-md) var(--ease-organic);
	}
	.scanlines {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 2;
		background: repeating-linear-gradient(
			to bottom,
			rgb(241 244 255 / 0.018) 0,
			rgb(241 244 255 / 0.018) 1px,
			rgb(0 0 0 / 0) 2px,
			rgb(0 0 0 / 0) 4px
		);
		animation: scan-shift 16s var(--ease-organic) infinite alternate;
	}

	.vignette {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 1;
		box-shadow: inset 0 0 180px rgb(0 0 0 / calc(0.62 - (var(--scroll-progress) * 0.34)));
	}

	.scroll-hint {
		position: fixed;
		right: 1rem;
		bottom: 3.4rem;
		z-index: 9;
		display: inline-flex;
		align-items: center;
		gap: 0.48rem;
		padding: 0.5rem 0.72rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgb(8 13 25 / 0.8);
		backdrop-filter: blur(4px);
		transition: opacity var(--dur-sm) var(--ease-organic), transform var(--dur-sm) var(--ease-organic);
		animation: hint-drift 5.6s var(--ease-organic) infinite;
	}

	.scroll-hint.is-hidden {
		opacity: 0;
		transform: translateY(14px);
		pointer-events: none;
	}

	.wheel {
		display: inline-block;
		width: 0.86rem;
		height: 1.26rem;
		border-radius: 999px;
		border: 1px solid var(--ink-soft);
		position: relative;
	}

	.wheel::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0.2rem;
		width: 0.18rem;
		height: 0.22rem;
		margin-left: -0.09rem;
		border-radius: 999px;
		background: var(--ink-soft);
		animation: wheel-dot 2.4s var(--ease-organic) infinite;
	}

	.arrow {
		font-size: 1rem;
		color: var(--ink-soft);
		animation: arrow-nudge 2.6s var(--ease-organic) infinite;
	}

	.rail {
		position: relative;
		z-index: 4;
		display: flex;
		height: 100vh;
		overflow-x: auto;
		overflow-y: hidden;
		gap: 1.2rem;
		padding: 1rem 1rem 4.2rem;
		scrollbar-width: none;
	}

	.rail::-webkit-scrollbar {
		display: none;
	}

	.panel {
		flex: 0 0 calc(100vw - 2rem);
		height: calc(100vh - 5.2rem);
		padding: clamp(0.9rem, 2vw, 1.6rem);
		overflow: visible;
	}

	.ghost-frame {
		position: relative;
		isolation: isolate;
		border-radius: 20px;
		background: transparent;
	}

	.ghost-frame::before {
		content: '';
		position: absolute;
		inset: -1px;
		border-radius: inherit;
		padding: 1px;
		background: conic-gradient(
			from 0deg,
			rgb(74 184 255 / 0.96),
			rgb(255 123 86 / 0.92),
			rgb(180 255 92 / 0.9),
			rgb(74 184 255 / 0.96)
		);
		-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		opacity: 0;
		transform: scale(0.985);
		filter: saturate(1.15) blur(0.2px);
		pointer-events: none;
		transition: opacity var(--dur-sm) var(--ease-organic), transform var(--dur-md) var(--ease-organic), filter var(--dur-md) var(--ease-organic);
	}

	.ghost-frame::after {
		content: '';
		position: absolute;
		inset: -14px;
		border-radius: inherit;
		background:
			radial-gradient(48% 62% at 16% 12%, rgb(74 184 255 / 0.4), transparent 78%),
			radial-gradient(52% 64% at 84% 84%, rgb(255 123 86 / 0.36), transparent 80%);
		opacity: 0;
		transform: scale(0.9);
		filter: blur(16px);
		pointer-events: none;
		z-index: -1;
		transition: opacity var(--dur-sm) var(--ease-organic), transform var(--dur-md) var(--ease-organic);
	}

	.ghost-frame:hover::before,
	.ghost-frame:focus-within::before {
		opacity: 0.92;
		transform: scale(1.006) translateY(-0.5px);
		filter: saturate(1.25) blur(0.1px);
		animation: frame-spin 3.8s var(--ease-organic) infinite;
	}

	.ghost-frame:hover::after,
	.ghost-frame:focus-within::after {
		opacity: 0.8;
		transform: scale(1.03);
	}

	.panel-hero {
		display: grid;
		grid-template-rows: auto auto;
		align-content: space-between;
	}

	.headline {
		margin: 0;
		font-family: 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(2.4rem, 8.8vw, 6.6rem);
		line-height: 0.78;
		letter-spacing: 0.005em;
		display: grid;
		gap: 0;
		align-content: start;
		align-self: start;
	}

	.headline-line {
		display: flex;
		flex-wrap: nowrap;
		white-space: nowrap;
		align-items: baseline;
		column-gap: 0.16em;
	}

	.headline-line + .headline-line {
		margin-top: -0.14em;
	}

	.headline-muted {
		color: rgb(241 244 255 / 0.32);
	}

	.headline-muted.amp {
		color: rgb(241 244 255 / 0.5);
	}

	.glitch-line {
		position: relative;
		color: var(--ink);
		will-change: transform;
		text-shadow:
			0 0 10px rgb(74 184 255 / 0.22),
			0 0 16px rgb(255 123 86 / 0.14);
		animation: headline-sway 5.2s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
	}

	.glitch-line::before,
	.glitch-line::after {
		content: attr(data-text);
		position: absolute;
		inset: 0;
		pointer-events: none;
		will-change: transform;
	}

	.line-top::before {
		color: var(--cyan);
		opacity: 0.9;
		animation:
			chroma-a 4.8s steps(2, end) infinite,
			glitch-cut-a 2.6s steps(2, end) infinite;
	}

	.line-top::after {
		color: var(--pink);
		opacity: 0.75;
		animation:
			chroma-b 5.2s steps(2, end) infinite,
			glitch-cut-b 2.9s steps(2, end) infinite;
	}

	.line-bottom::before {
		color: var(--amber);
		opacity: 0.82;
		animation:
			chroma-c 4.9s steps(2, end) infinite,
			glitch-cut-c 2.7s steps(2, end) infinite;
	}

	.line-bottom::after {
		color: var(--acid);
		opacity: 0.68;
		animation:
			chroma-d 5.4s steps(2, end) infinite,
			glitch-cut-d 3.1s steps(2, end) infinite;
	}

	.hero-bottom {
		margin-top: 0.58rem;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.9rem, 1.6vw, 1.3rem);
		align-items: start;
	}

	.hero-copy {
		margin: 0;
		font-size: clamp(0.98rem, 1.1vw, 1.12rem);
		line-height: 1.55;
		color: rgb(225 234 255 / 0.92);
		max-width: 56ch;
	}

	.panel-projects {
		display: flex;
		align-items: center;
	}

	.project-grid {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.95rem;
	}

	.project-frame {
		padding: 1.14rem;
		border-radius: 20px;
		display: grid;
		gap: 0.72rem;
		transition: transform var(--dur-md) var(--ease-organic), filter var(--dur-md) var(--ease-organic);
	}

	.project-frame:hover {
		transform: translateY(-4px);
	}

	.project-id {
		margin: 0;
		font-family: 'Archivo Black', 'Impact', sans-serif;
		font-size: clamp(1.7rem, 3.8vw, 2.6rem);
		line-height: 1;
		color: rgb(241 244 255 / 0.22);
	}

	.project-role {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.project-title {
		margin: 0;
		font-size: clamp(1.55rem, 3vw, 2.2rem);
		line-height: 0.95;
	}

	.project-copy {
		margin: 0;
		line-height: 1.56;
		color: rgb(241 244 255 / 0.86);
	}

	.project-tags {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		gap: 0.42rem;
		flex-wrap: wrap;
	}

	.project-tag {
		padding: 0;
		font-size: 0.73rem;
		color: var(--ink-soft);
		background: transparent;
	}

	.project-tag::before {
		content: '• ';
		opacity: 0.56;
	}

	.project-link {
		justify-self: start;
		display: inline-flex;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.82rem;
		color: #ffffff;
		padding: 0.52rem 0.84rem;
		border-radius: 999px;
		border: 1px solid transparent;
		background: linear-gradient(130deg, var(--pink), var(--cyan));
	}

	.theme-blue {
	}

	.theme-blue .project-title {
		color: var(--cyan);
	}

	.theme-orange {
	}

	.theme-orange .project-title {
		color: var(--pink);
	}

	.panel-value {
		display: flex;
		align-items: center;
	}

	.value-shell {
		width: min(1080px, 100%);
		display: grid;
		grid-template-columns: 1.15fr 1.85fr;
		gap: 1rem;
	}

	.value-intro {
		position: relative;
		overflow: visible;
		padding: 1.1rem;
		border-radius: 20px;
		animation: intro-float 9.4s var(--ease-organic) infinite;
		transition: transform var(--dur-md) var(--ease-organic), filter var(--dur-md) var(--ease-organic);
	}

	.value-intro:hover {
		transform: translateY(-4px);
	}

	.value-intro:hover::before {
		opacity: 0.86;
		filter: saturate(1.2) blur(0.1px);
		animation-duration: 3.8s;
	}

	.value-intro:hover::after {
		opacity: 0.76;
		transform: scale(1.02);
		filter: blur(18px);
	}

	.value-kicker {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.value-title {
		margin: 0.55rem 0 0;
		font-size: clamp(1.44rem, 2.8vw, 2.44rem);
		line-height: 0.98;
		color: var(--ink);
	}

	.value-copy {
		margin: 0.72rem 0 0;
		line-height: 1.62;
		color: var(--ink-soft);
	}

	.selling-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem;
	}

	.selling-card {
		padding: 0.95rem;
		border-radius: 16px;
		overflow: visible;
		transform: perspective(980px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition: transform var(--dur-md) var(--ease-organic), filter var(--dur-sm) var(--ease-organic);
	}

	.selling-card:hover {
		transform: perspective(980px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateY(-4px) scale(1.015);
	}

	.selling-card:hover .selling-copy {
		color: rgb(241 244 255 / 0.95);
		transform: translateY(-1px);
	}

	.selling-title {
		margin: 0;
		font-size: 0.96rem;
		line-height: 1.22;
		color: var(--ink);
	}

	.selling-copy {
		margin: 0.48rem 0 0;
		line-height: 1.52;
		color: var(--ink-soft);
		transition: color var(--dur-sm) var(--ease-organic), transform var(--dur-sm) var(--ease-organic);
	}

	.panel-contact {
		display: flex;
		align-items: center;
	}

	.contact-shell {
		width: min(1080px, 100%);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
		gap: 1rem;
	}

	.contact-shell > * {
		min-width: 0;
	}
	.contact-intro,
	.contact-form {
		border-radius: 20px;
		background: transparent;
		box-shadow: none;
	}

	.contact-intro {
		padding: 1rem;
	}

	.contact-kicker {
		margin: 0;
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.contact-title {
		margin: 0.52rem 0 0;
		font-size: clamp(1.24rem, 2.15vw, 1.9rem);
		line-height: 1.1;
		color: var(--ink);
	}

	.contact-copy {
		margin: 0.72rem 0 0;
		line-height: 1.58;
		color: var(--ink-soft);
	}

	.contact-form {
		position: relative;
		overflow: visible;
		padding: 1rem;
		display: grid;
		gap: 0.74rem;
	}


	.contact-form > * {
		position: relative;
		z-index: 1;
	}

	.field {
		display: grid;
		gap: 0.32rem;
	}

	.field-label {
		font-size: 0.76rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.field input,
	.field textarea,
	.field select {
		width: 100%;
		max-width: 100%;
		font: inherit;
		color: var(--ink);
		background: transparent;
		border: 0;
		border-bottom: 1px solid rgb(173 184 216 / 0.44);
		border-radius: 0;
		padding: 0.64rem 0;
		outline: none;
		transition: border-color var(--dur-sm) var(--ease-organic), background-size var(--dur-sm) var(--ease-organic);
		background-image: linear-gradient(90deg, var(--pink), var(--cyan), var(--acid));
		background-size: 0 2px;
		background-position: 0 100%;
		background-repeat: no-repeat;
	}
	.field select {
		appearance: none;
		-webkit-appearance: none;
		-moz-appearance: none;
		cursor: pointer;
	}

	.field select:invalid {
		color: rgb(173 184 216 / 0.78);
	}

	.field select option {
		color: #0f172a;
		background: #f2f6ff;
	}

	.field select option:disabled {
		color: #64748b;
	}

	.field input::placeholder,
	.field textarea::placeholder {
		color: rgb(173 184 216 / 0.68);
	}

	.field textarea {
		resize: vertical;
		min-height: 7.2rem;
	}

	.field input:focus,
	.field textarea:focus,
	.field select:focus {
		border-bottom-color: rgb(241 244 255 / 0.9);
		background-size: 100% 2px;
	}

	.contact-submit {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		font-weight: 700;
		font-size: 0.88rem;
		color: #fff;
		padding: 0.58rem 0.92rem;
		border-radius: 999px;
		border: 1px solid transparent;
		background: linear-gradient(130deg, var(--pink), var(--cyan));
		cursor: pointer;
		transition: transform var(--dur-sm) var(--ease-organic), box-shadow var(--dur-sm) var(--ease-organic);
	}

	.contact-submit:hover {
		transform: translateY(-2px) scale(1.012);
		box-shadow: 0 10px 22px rgb(72 170 255 / 0.34);
	}

	.contact-status {
		margin: 0.2rem 0 0;
		min-height: 1.2rem;
		font-size: 0.82rem;
		color: var(--ink-soft);
	}
	.global-signal {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 10;
		overflow: hidden;
		background: rgb(8 13 24 / 0.88);
		backdrop-filter: blur(6px);
	}

	.global-signal-track {
		display: flex;
		width: max-content;
		gap: 0.66rem;
		padding: 0.58rem 0.72rem;
		will-change: transform;
		animation: ticker 27s linear infinite;
	}

	.signal-chip {
		font-family: 'IBM Plex Mono', 'Consolas', monospace;
		font-size: 0.69rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.28rem 0.54rem;
		border: none;
		border-radius: 999px;
		color: var(--ink-soft);
		background: rgb(255 255 255 / 0.1);
	}

	.reveal {
		opacity: 0;
		transform: translate3d(0, 22px, 0) scale(0.985);
		animation: reveal 1080ms var(--ease-bouncy) forwards;
	}

	.reveal-1 {
		animation-delay: 120ms;
	}

	.reveal-2 {
		animation-delay: 230ms;
	}

	.reveal-3 {
		animation-delay: 360ms;
	}

	@keyframes reveal {
		0% {
			opacity: 0;
			transform: translate3d(0, 22px, 0) scale(0.985);
		}
		66% {
			opacity: 1;
			transform: translate3d(0, -1.5px, 0) scale(1.003);
		}
		100% {
			opacity: 1;
			transform: translate3d(0, 0, 0) scale(1);
		}
	}

	@keyframes ticker {
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	@keyframes scan-shift {
		0% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(2px);
		}
		100% {
			transform: translateY(4px);
		}
	}

	@keyframes wheel-dot {
		0% {
			opacity: 0;
			transform: translateY(-0.06rem) scale(0.85);
		}
		24% {
			opacity: 1;
		}
		62% {
			opacity: 0.9;
			transform: translateY(0.44rem) scale(1);
		}
		100% {
			opacity: 0;
			transform: translateY(0.74rem) scale(0.9);
		}
	}

	@keyframes arrow-nudge {
		0%,
		100% {
			transform: translateX(0) rotate(0deg);
		}
		36% {
			transform: translateX(4px) rotate(1deg);
		}
		66% {
			transform: translateX(2px) rotate(-0.6deg);
		}
	}

	@keyframes hint-drift {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-2px);
		}
	}

	@keyframes orb-drift-a {
		0% {
			transform: translate3d(0, 0, 0) scale(1);
		}
		26% {
			transform: translate3d(2.2vw, -1.3vh, 0) scale(1.06);
		}
		58% {
			transform: translate3d(4.6vw, 2.4vh, 0) scale(1.12);
		}
		82% {
			transform: translate3d(1.2vw, 1.4vh, 0) scale(1.05);
		}
		100% {
			transform: translate3d(0, 0, 0) scale(1);
		}
	}

	@keyframes orb-drift-b {
		0% {
			transform: translate3d(0, 0, 0) scale(1);
		}
		30% {
			transform: translate3d(-2.8vw, -1.2vh, 0) scale(1.06);
		}
		62% {
			transform: translate3d(-5.4vw, -2.6vh, 0) scale(1.11);
		}
		86% {
			transform: translate3d(-2vw, -0.8vh, 0) scale(1.04);
		}
		100% {
			transform: translate3d(0, 0, 0) scale(1);
		}
	}

	@keyframes headline-sway {
		0%,
		100% {
			transform: translate3d(0, 0, 0);
		}
		22% {
			transform: translate3d(1.5px, -0.8px, 0);
		}
		52% {
			transform: translate3d(-1.2px, 0.6px, 0);
		}
		74% {
			transform: translate3d(0.8px, -0.4px, 0);
		}
	}

	@keyframes chroma-a {
		0%,
		100% {
			transform: translate3d(-3px, 0, 0);
		}
		40% {
			transform: translate3d(2.8px, -1.1px, 0);
		}
		75% {
			transform: translate3d(-2px, 0.8px, 0);
		}
	}

	@keyframes chroma-b {
		0%,
		100% {
			transform: translate3d(2.7px, 0, 0);
		}
		36% {
			transform: translate3d(-2.9px, 1.2px, 0);
		}
		72% {
			transform: translate3d(1.9px, -0.9px, 0);
